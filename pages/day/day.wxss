.page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header {
  padding: var(--spacing-md) var(--spacing-lg);
  text-align: center;
}

.header__date {
  font-size: var(--font-lg);
  font-weight: 600;
}

.timeline {
  height: calc(100vh - 180rpx);
}

.timeline__body {
  position: relative;
  padding-left: 120rpx;
  padding-right: var(--spacing-md);
}

.time-slot {
  height: 120rpx;
  position: relative;
}

.time-slot__label {
  position: absolute;
  left: -110rpx;
  top: -16rpx;
  font-size: var(--font-xs);
  color: var(--text-light);
  width: 90rpx;
  text-align: right;
}

.time-slot__line {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: var(--bg-hairline);
}

.session-pos {
  position: absolute;
  left: 120rpx;
  right: var(--spacing-md);
  z-index: 2;
}

.current-time {
  position: absolute;
  left: 100rpx;
  right: 0;
  z-index: 5;
  display: flex;
  align-items: center;
}

.current-time__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E53935;
  flex-shrink: 0;
}

.current-time__line {
  flex: 1;
  height: 2rpx;
  background: #E53935;
}

.fab {
  position: fixed;
  right: var(--spacing-lg);
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.fab__icon {
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
}
