<view class="page">
  <view class="header">
    <input class="search" placeholder="搜索会员" value="{{searchKeyword}}" bindinput="onSearch" />
    <view class="stats-btn" bindtap="onGoStats">统计</view>
    <view class="add-btn" bindtap="onAddMember">+</view>
  </view>

  <empty-state
    wx:if="{{isEmpty}}"
    title="还没有会员"
    subtitle="点击右上角 + 添加会员"
  />

  <view class="list" wx:else>
    <view
      class="member-row"
      wx:for="{{filteredMembers}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onMemberTap"
    >
      <member-avatar src="{{item.avatar}}" size="medium" />
      <view class="member-info">
        <view class="member-info__top">
          <text class="member-name">{{item.name}}</text>
          <view class="member-tags">
            <tag wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" text="{{t}}" />
          </view>
        </view>
        <view class="member-info__bottom">
          <text class="member-stat" wx:if="{{item.lastSessionDate}}">最近: {{item.lastSessionDate}}</text>
          <text class="member-stat">共 {{item.totalSessions}} 节</text>
        </view>
      </view>
      <text class="member-arrow">›</text>
    </view>
  </view>
</view>
