<view class="ai-card">
  <view class="ai-card__head">
    <view>
      <text class="ai-card__eyebrow">课表</text>
      <text class="ai-card__title">{{rangeLabel || '本周'}}</text>
    </view>
    <view class="ai-card__metric">
      <text class="ai-card__metric-num">{{total}}</text>
      <text class="ai-card__metric-label">节</text>
    </view>
  </view>

  <view wx:if="{{!hasDays}}" class="empty">
    <text>这一周还没有课程</text>
  </view>

  <view wx:else class="overview">
    <view class="week-strip">
      <view wx:for="{{days}}" wx:key="date" class="day {{item.isBusy ? 'day--busy' : ''}}">
        <text class="day__name">{{item.weekday}}</text>
        <view class="day__bar-wrap">
          <view wx:if="{{item.isBusy}}" class="day__bar" style="{{item.barStyle}}"></view>
        </view>
        <text class="day__count">{{item.count}}</text>
      </view>
    </view>

    <view class="summary">
      <text>本周 {{busyDayCount}} 天有课</text>
      <text wx:if="{{hiddenCount > 0}}">还有 {{hiddenCount}} 节在完整课表中查看</text>
    </view>

    <view class="highlights" wx:if="{{hasHighlights}}">
      <view wx:for="{{highlights}}" wx:key="id" class="highlight highlight--{{item.status}}">
        <text class="highlight__date">{{item.weekday}} {{item.dayNum}}</text>
        <text class="highlight__time">{{item.startTime}}</text>
        <view class="highlight__main">
          <text class="highlight__name">{{item.memberName}}</text>
          <text class="highlight__meta">{{item.courseType}}</text>
        </view>
        <text class="highlight__status">{{item.statusLabel}}</text>
      </view>
    </view>
  </view>
</view>
