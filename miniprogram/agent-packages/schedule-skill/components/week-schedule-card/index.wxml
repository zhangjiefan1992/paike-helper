<view class="ai-card">
  <view class="ai-card__head">
    <view>
      <text class="ai-card__eyebrow">课表</text>
      <text class="ai-card__title">{{rangeLabel || '本周'}}</text>
    </view>
    <view class="ai-card__metric">
      <text class="ai-card__metric-num">{{total}}</text>
      <text class="ai-card__metric-label">节</text>
    </view>
  </view>

  <view wx:if="{{!hasDays}}" class="empty">
    <text>这一周还没有课程</text>
  </view>

  <view wx:else class="overview">
    <view class="mini-grid">
      <view wx:for="{{days}}" wx:key="date" class="mini-day {{item.hasCards ? '' : 'mini-day--empty'}}">
        <view class="mini-day__head">
          <text class="mini-day__weekday">周{{item.weekdayLabel}}</text>
          <text class="mini-day__num">{{item.dayNum}}</text>
        </view>
        <view class="mini-day__body">
          <view
            wx:for="{{item.cards}}"
            wx:for-item="card"
            wx:key="id"
            class="mini-card mini-card--{{card.status}}"
            style="{{card.cardStyle}}"
          >
            <text class="mini-card__time">{{card.startTime}}</text>
            <text class="mini-card__name">{{card.memberName}}</text>
          </view>
          <view wx:if="{{item.moreCount > 0}}" class="mini-more">+{{item.moreCount}}</view>
          <view wx:if="{{!item.hasCards}}" class="mini-empty"></view>
        </view>
      </view>
    </view>

    <view class="summary">
      <text>本周 {{busyDayCount}} 天有课</text>
      <text wx:if="{{hiddenCount > 0}}">还有 {{hiddenCount}} 节在完整课表中查看</text>
    </view>
  </view>
</view>
