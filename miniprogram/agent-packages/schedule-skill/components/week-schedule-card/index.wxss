.ai-card {
  padding: 20rpx;
  background: var(--bg-card, #ffffff);
  border: 1rpx solid var(--rule, #e8e2d8);
  border-radius: var(--radius-md, 16rpx);
  color: var(--ink, #1f1d1a);
  box-shadow: var(--shadow-card, 0 1rpx 6rpx rgba(31, 29, 26, 0.04));
}

.ai-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.ai-card__eyebrow,
.ai-card__title {
  display: block;
}

.ai-card__eyebrow {
  font-size: 20rpx;
  color: var(--ink-3, #7a7470);
}

.ai-card__title {
  margin-top: 2rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink, #1f1d1a);
}

.ai-card__metric {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.ai-card__metric-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.ai-card__metric-label {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3, #7a7470);
}

.empty {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--rule-soft, #f0ebe2);
  font-size: 24rpx;
  color: var(--ink-3, #7a7470);
}

.overview {
  margin-top: 16rpx;
}

.mini-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  border: 1rpx solid var(--rule, #e2e7f2);
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--rule, #e2e7f2);
  gap: 1rpx;
}

.mini-day {
  min-width: 0;
  background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
}

.mini-day--empty {
  background: #f7f9fd;
}

.mini-day__head {
  padding: 8rpx 2rpx 6rpx;
  text-align: center;
  background: #f1f4fa;
}

.mini-day__weekday,
.mini-day__num {
  display: block;
}

.mini-day__weekday {
  font-size: 18rpx;
  color: #8088a8;
  font-weight: 600;
  line-height: 1;
}

.mini-day__num {
  margin-top: 2rpx;
  font-size: 17rpx;
  color: #b0b6cc;
  line-height: 1;
}

.mini-day__body {
  min-height: 150rpx;
  padding: 7rpx 4rpx;
  box-sizing: border-box;
}

.mini-card {
  position: relative;
  min-height: 48rpx;
  margin-bottom: 6rpx;
  padding: 5rpx 5rpx 4rpx 8rpx;
  border-radius: 7rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 9rpx rgba(24, 32, 68, 0.12);
  overflow: hidden;
}

.mini-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 5rpx;
  background: var(--card-accent, rgba(255,255,255,0.5));
}

.mini-card--completed {
  opacity: 0.72;
}

.mini-card--cancelled {
  opacity: 0.58;
}

.mini-card__time,
.mini-card__name {
  display: block;
  position: relative;
  z-index: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-card__time {
  font-size: 17rpx;
  line-height: 1;
  font-weight: 700;
}

.mini-card__name {
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 1.05;
  font-weight: 700;
}

.mini-more {
  height: 30rpx;
  border-radius: 999rpx;
  background: rgba(24, 32, 68, 0.06);
  color: #4a5070;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  font-weight: 600;
}

.mini-empty {
  height: 1rpx;
  width: 24rpx;
  margin: 62rpx auto 0;
  background: #d8deeb;
}

.summary {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--ink-3, #7a7470);
}

.summary text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
