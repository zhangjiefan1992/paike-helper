.ai-card {
  padding: 20rpx;
  background: var(--bg-card, #ffffff);
  border: 1rpx solid var(--rule, #e8e2d8);
  border-radius: var(--radius-md, 16rpx);
  color: var(--ink, #1f1d1a);
  box-shadow: var(--shadow-card, 0 1rpx 6rpx rgba(31, 29, 26, 0.04));
}

.ai-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.ai-card__eyebrow,
.ai-card__title {
  display: block;
}

.ai-card__eyebrow {
  font-size: 20rpx;
  color: var(--ink-3, #7a7470);
}

.ai-card__title {
  margin-top: 2rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink, #1f1d1a);
}

.ai-card__metric {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.ai-card__metric-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.ai-card__metric-label {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3, #7a7470);
}

.empty {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--rule-soft, #f0ebe2);
  font-size: 24rpx;
  color: var(--ink-3, #7a7470);
}

.overview {
  margin-top: 16rpx;
}

.week-strip {
  display: flex;
  gap: 8rpx;
}

.day {
  flex: 1;
  min-width: 0;
  padding: 10rpx 4rpx 8rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--rule-soft, #f0ebe2);
  text-align: center;
}

.day--busy {
  background: var(--color-primary-light, rgba(74, 124, 89, 0.08));
}

.day__name,
.day__count {
  display: block;
}

.day__name {
  font-size: 18rpx;
  color: var(--ink-3, #7a7470);
  line-height: 1;
}

.day__bar-wrap {
  height: 52rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin: 6rpx 0;
}

.day__bar {
  width: 18rpx;
  min-height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-primary, #4a7c59);
}

.day__count {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--ink, #1f1d1a);
}

.summary {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--ink-3, #7a7470);
}

.summary text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.highlights {
  margin-top: 10rpx;
}

.highlight {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 44rpx;
  border-top: 1rpx solid var(--rule-soft, #f0ebe2);
  font-size: 21rpx;
}

.highlight:first-child {
  border-top: 0;
}

.highlight__date {
  width: 58rpx;
  flex-shrink: 0;
  color: var(--ink-3, #7a7470);
}

.highlight__time {
  width: 58rpx;
  flex-shrink: 0;
  color: var(--ink-2, #4a4642);
}

.highlight__main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.highlight__name,
.highlight__meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.highlight__name {
  color: var(--ink, #1f1d1a);
}

.highlight__meta {
  flex-shrink: 0;
  max-width: 90rpx;
  font-size: 19rpx;
  color: var(--ink-3, #7a7470);
}

.highlight__status {
  flex-shrink: 0;
  color: var(--ink-3, #7a7470);
}

.highlight--completed .highlight__status {
  color: var(--color-primary, #4a7c59);
}

.highlight--cancelled .highlight__name {
  color: var(--ink-4, #a8a29b);
  text-decoration: line-through;
}

.highlight--noshow .highlight__status {
  color: var(--warm, #b5573d);
}
