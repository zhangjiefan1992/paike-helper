.ai-card {
  padding: 20rpx;
  background: var(--bg-card, #ffffff);
  border: 1rpx solid var(--rule, #e8e2d8);
  border-radius: var(--radius-md, 16rpx);
  color: var(--ink, #1f1d1a);
  box-shadow: var(--shadow-card, 0 1rpx 6rpx rgba(31, 29, 26, 0.04));
}

.ai-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.ai-card__eyebrow,
.ai-card__title {
  display: block;
}

.ai-card__eyebrow {
  font-size: 20rpx;
  color: var(--ink-3, #7a7470);
}

.ai-card__title {
  margin-top: 2rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink, #1f1d1a);
}

.ai-card__metric {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.ai-card__metric-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.ai-card__metric-label {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3, #7a7470);
}

.empty {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--rule-soft, #f0ebe2);
  font-size: 24rpx;
  color: var(--ink-3, #7a7470);
}

.days {
  margin-top: 12rpx;
}

.day {
  padding: 14rpx 0;
  border-top: 1rpx solid var(--rule-soft, #f0ebe2);
}

.day:first-child {
  border-top: 0;
}

.day__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
}

.day__name {
  font-weight: 600;
}

.day__count {
  color: var(--ink-3, #7a7470);
}

.session-list {
  margin-top: 8rpx;
}

.session {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 48rpx;
  font-size: 22rpx;
}

.session__time {
  width: 70rpx;
  flex-shrink: 0;
  color: var(--ink-2, #4a4642);
}

.session__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.session__name,
.session__meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session__name {
  color: var(--ink, #1f1d1a);
}

.session__meta {
  font-size: 20rpx;
  color: var(--ink-3, #7a7470);
}

.session__status {
  flex-shrink: 0;
  color: var(--ink-3, #7a7470);
}

.session--completed .session__status {
  color: var(--color-primary, #4a7c59);
}

.session--cancelled .session__name {
  color: var(--ink-4, #a8a29b);
  text-decoration: line-through;
}

.session--noshow .session__status {
  color: var(--warm, #b5573d);
}

.more {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-3, #7a7470);
}
