.ai-card {
  padding: 20rpx;
  background: var(--bg-card, #ffffff);
  border: 1rpx solid var(--rule, #e8e2d8);
  border-radius: var(--radius-md, 16rpx);
  color: var(--ink, #1f1d1a);
  box-shadow: var(--shadow-card, 0 1rpx 6rpx rgba(31, 29, 26, 0.04));
}

.ai-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.ai-card__eyebrow,
.ai-card__title {
  display: block;
}

.ai-card__eyebrow {
  font-size: 20rpx;
  color: var(--warm, #b5573d);
}

.ai-card__title {
  margin-top: 2rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.replace {
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--color-primary-light, rgba(74, 124, 89, 0.08));
  font-size: 20rpx;
  color: var(--color-primary, #4a7c59);
}

.summary {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.summary__item {
  flex: 1;
  padding: 12rpx 8rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--rule-soft, #f0ebe2);
  text-align: center;
}

.summary__num,
.summary__label {
  display: block;
}

.summary__num {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
}

.summary__label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-3, #7a7470);
}

.issue {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: rgba(181, 87, 61, 0.08);
  font-size: 22rpx;
  color: var(--warm, #b5573d);
}

.session-list {
  margin-top: 12rpx;
}

.session {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 52rpx;
  border-top: 1rpx solid var(--rule-soft, #f0ebe2);
  font-size: 22rpx;
}

.session:first-child {
  border-top: 0;
}

.session__time {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--ink-2, #4a4642);
}

.session__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.session__name,
.session__meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session__meta {
  font-size: 20rpx;
  color: var(--ink-3, #7a7470);
}

.more {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink-3, #7a7470);
}

.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.btn {
  flex: 1;
  min-height: 68rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--rule-soft, #f0ebe2);
  color: var(--ink, #1f1d1a);
  font-size: 24rpx;
  line-height: 68rpx;
}

.btn::after {
  border: 0;
}

.btn--primary {
  background: var(--ink, #1f1d1a);
  color: var(--paper, #faf7f0);
}
