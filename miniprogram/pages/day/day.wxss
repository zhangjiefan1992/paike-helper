.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 120rpx;
  overflow-x: hidden;
}
.swipe-wrap { will-change: transform; }
.swipe-wrap--animating {
  transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}

/* === Header === */
.hdr {
  padding: 44rpx 56rpx 32rpx;
}
.hdr__date {
  display: block;
  font-size: 56rpx;
  font-weight: 400;
  line-height: 1;
  color: var(--ink);
  letter-spacing: -0.02em;
  margin-bottom: 12rpx;
}
.hdr__sub {
  font-style: italic;
  font-weight: 300;
  font-size: 26rpx;
  color: var(--ink-3);
}

.rule {
  height: 1rpx;
  background: var(--rule);
  margin: 0 56rpx;
}

/* === Empty === */
.empty {
  text-align: center;
  padding: 160rpx 64rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty__mark {
  width: 80rpx;
  height: 1rpx;
  background: var(--ink-4);
  opacity: 0.5;
  margin-bottom: 56rpx;
}
.empty__title {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--ink);
  letter-spacing: -0.01em;
  margin-bottom: 14rpx;
  line-height: 1.2;
}
.empty__hint {
  font-style: italic;
  font-weight: 300;
  font-size: 26rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.bottom-actions {
  position: fixed;
  bottom: 56rpx;
  left: 0; right: 0;
  display: flex;
  justify-content: center;
}
.bottom-cta {
  padding: 24rpx 56rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: 28rpx;
  letter-spacing: 0.06em;
  border-radius: 999rpx;
}
.bottom-cta:active { background: var(--ink-2); }

/* === Timeline === */
.timeline {
  height: calc(100vh - 280rpx);
}
.timeline__body {
  position: relative;
  padding: 24rpx 56rpx 80rpx;
}

.slot {
  position: relative;
  height: 80rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.slot__label {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 300;
  color: var(--ink-4);
  letter-spacing: 0.02em;
  padding-top: 0;
  text-align: right;
}
.slot__line {
  flex: 1;
  height: 1rpx;
  background: var(--rule-soft);
  margin-top: 12rpx;
}
.slot:active .slot__line {
  background: var(--ink-4);
}

.session-pos {
  position: absolute;
  left: 132rpx;
  right: 56rpx;
}

/* === Current time indicator === */
.now {
  position: absolute;
  left: 96rpx;
  right: 0;
  height: 0;
  display: flex;
  align-items: center;
  pointer-events: none;
  z-index: 5;
}
.now__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--warm);
  flex-shrink: 0;
}
.now__line {
  flex: 1;
  height: 1rpx;
  background: var(--warm);
  margin-left: 4rpx;
}

/* === FAB === */
.fab {
  position: fixed;
  right: 44rpx;
  bottom: calc(env(safe-area-inset-bottom) + 44rpx);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(31, 29, 26, 0.18);
  z-index: 100;
}
.fab:active {
  transform: scale(0.92);
}
.fab__plus {
  font-size: 48rpx;
  color: var(--paper);
  font-weight: 300;
  line-height: 1;
}
