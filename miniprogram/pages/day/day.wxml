<view class="page" bindtouchstart="onSwipeStart" bindtouchmove="onSwipeMove" bindtouchend="onSwipeEnd">
  <view class="swipe-wrap {{swipeAnimating ? 'swipe-wrap--animating' : ''}}" style="{{swipeTransform}}">

    <view class="hdr">
      <text class="hdr__date serif">{{dateLabel}}</text>
      <text class="hdr__sub serif" wx:if="{{sessions.length}}">{{sessions.length}} 节课</text>
      <text class="hdr__sub serif" wx:else>无课</text>
    </view>

    <view class="rule"></view>

    <!-- Empty -->
    <view class="empty" wx:if="{{sessions.length === 0}}">
      <view class="empty__mark"></view>
      <text class="empty__title serif">空白的一天</text>
      <text class="empty__hint serif">点击下方任意时段，安排一节</text>
    </view>

    <!-- Timeline -->
    <scroll-view class="timeline" scroll-y wx:else>
      <view class="timeline__body">
        <!-- Time slots -->
        <view class="slot" wx:for="{{timeSlots}}" wx:key="*this" data-time="{{item}}" bindtap="onSlotTap">
          <text class="slot__label serif">{{item}}</text>
          <view class="slot__line"></view>
        </view>

        <!-- Sessions positioned absolutely -->
        <view
          class="session-pos"
          wx:for="{{sessions}}"
          wx:key="id"
          style="top: {{item._top}}rpx; height: {{item._height}}rpx;"
        >
          <session-card
            session="{{item}}"
            memberName="{{memberMap[item.memberId].name || (item.classMode === 'group' ? '团课' : '')}}"
            compact="{{false}}"
            bind:cardtap="onSessionTap"
            bind:complete="onComplete"
            bind:cancel="onCancel"
          />
        </view>

        <!-- Current time indicator -->
        <view class="now" wx:if="{{showTimeLine}}" style="top: {{currentTimeTop}}rpx;">
          <view class="now__dot"></view>
          <view class="now__line"></view>
        </view>
      </view>
    </scroll-view>

    <!-- Empty state CTA: also works under timeline -->
    <view class="bottom-actions" wx:if="{{sessions.length === 0}}">
      <view class="bottom-cta" bindtap="onAddSession">新建课程 →</view>
    </view>

  </view>

  <!-- FAB only when there are sessions -->
  <view class="fab" wx:if="{{sessions.length > 0}}" bindtap="onAddSession">
    <text class="fab__plus">+</text>
  </view>
</view>
