<view class="page theme-{{currentTheme}}"
  bindtouchstart="onSwipeStart" bindtouchmove="onSwipeMove" bindtouchend="onSwipeEnd"
>
  <!-- Header -->
  <view class="hdr">
    <view class="hdr__top">
      <text class="hdr__title serif" bindlongpress="onWeekLongPress">{{rangeLabel}}</text>
      <view class="hdr__today" bindtap="goToday">今天</view>
    </view>
    <view class="hdr__nav">
      <view class="hdr__nav-left">
        <view class="seg">
          <view class="seg__item {{currentView === 'week' ? 'seg__item--active' : ''}}"
            bindtap="onSwitchView" data-view="week">周</view>
          <view class="seg__item {{currentView === 'month' ? 'seg__item--active' : ''}}"
            bindtap="onSwitchView" data-view="month">月</view>
        </view>
        <text class="hdr__stats" wx:if="{{currentView === 'week' && !isEmpty}}">{{stats.total}}节 · 已完成{{stats.completed}}</text>
        <text class="hdr__stats" wx:if="{{currentView === 'month' && !monthIsEmpty}}">{{monthStats.total}}节 · 已完成{{monthStats.completed}}</text>
      </view>
      <view class="hdr__arrows">
        <view class="hdr__arrow" bindtap="onPrev">‹</view>
        <view class="hdr__arrow" bindtap="onNext">›</view>
      </view>
    </view>
  </view>

  <!-- Swipeable content -->
  <view class="swipe-wrap {{swipeAnimating ? 'swipe-wrap--animating' : ''}}"
    style="{{swipeTransform}}">

  <!-- ===== 周视图 ===== -->
  <block wx:if="{{currentView === 'week'}}">

  <!-- Empty state -->
  <view class="empty" wx:if="{{isEmpty}}">
    <view class="empty__mark"></view>
    <text class="empty__title serif">这周尚是空白</text>
    <text class="empty__hint serif">把整周课表粘进来，AI 自动整理</text>
    <view class="empty__cta" bindtap="onTextImport">
      <text>批量导入</text>
      <text class="empty__cta-arrow">→</text>
    </view>
    <text class="empty__alt" bindtap="onAddSession">或新增单节课程</text>
  </view>

  <!-- 竞品式时段课表 -->
  <view class="cp-grid" wx:if="{{!isEmpty}}">
    <view class="cp-grid__head">
      <view class="cp-grid__time-head"></view>
      <view wx:for="{{weekDays}}" wx:key="date"
        class="cp-grid__day-head {{item.isToday ? 'cp-grid__day-head--today' : ''}}"
        bindtap="onDayTap" data-date="{{item.date}}">
        <text class="cp-grid__weekday">{{item.weekday}}</text>
        <text class="cp-grid__daynum serif">{{item.dayNum}}</text>
      </view>
    </view>

    <view class="cp-grid__body">
      <view wx:for="{{cpRows}}" wx:for-item="row" wx:key="key"
        class="cp-row {{row.hasCourse ? 'cp-row--busy' : 'cp-row--empty'}}"
        style="height:{{row.rowHeightRpx}}rpx">
        <view class="cp-row__period">
          <text class="cp-row__label serif">{{row.label}}</text>
          <text class="cp-row__range">{{row.range}}</text>
        </view>
        <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="date"
          class="cp-cell {{cell.isToday ? 'cp-cell--today' : ''}}"
          bindtap="onCellTap" data-date="{{cell.date}}" data-time="{{cell.seedTime}}">
          <view class="cp-cell__empty" wx:if="{{cell.cards.length === 0}}">
            <text>＋</text>
          </view>
          <view wx:for="{{cell.cards}}" wx:for-item="card" wx:key="id"
            class="cp-card cp-card--{{card.displayMode}} {{card.done ? 'cp-card--done' : ''}}"
            style="top:{{card.topRpx}}rpx;height:{{card.cardH}}rpx;{{card.cardStyle}}"
            catchtap="onCardTap" catchlongpress="onCardLongPress"
            data-id="{{card.id}}">
            <text class="cp-card__time" style="color:{{card.textColor}}">{{card.startTime}}</text>
            <text class="cp-card__name" style="color:{{card.textColor}}">{{card.memberName}}</text>
            <text class="cp-card__meta" wx:if="{{card.metaLabel}}" style="color:{{card.textColor}}">{{card.metaLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  </block>

  <!-- ===== 月视图 ===== -->
  <block wx:if="{{currentView === 'month'}}">
  <view class="month-grid">
    <view class="month-grid__head">
      <view class="month-grid__weekday">一</view>
      <view class="month-grid__weekday">二</view>
      <view class="month-grid__weekday">三</view>
      <view class="month-grid__weekday">四</view>
      <view class="month-grid__weekday">五</view>
      <view class="month-grid__weekday">六</view>
      <view class="month-grid__weekday">日</view>
    </view>
    <view class="month-grid__body">
      <view wx:for="{{monthDays}}" wx:key="date"
        class="month-cell {{item.isToday ? 'month-cell--today' : ''}} {{item.isOutside ? 'month-cell--outside' : ''}}"
        bindtap="onMonthCellTap" data-date="{{item.date}}">
        <text class="month-cell__day {{item.isToday ? 'month-cell__day--today' : ''}} serif">{{item.day}}</text>
        <view class="month-dots" wx:if="{{item.dots.length > 0}}">
          <view wx:for="{{item.dots}}" wx:for-item="dot" wx:key="bg"
            class="month-dot" style="background:{{dot.bg}}"></view>
        </view>
        <text class="month-count" wx:if="{{item.count > 3}}">{{item.count}}节</text>
      </view>
    </view>
  </view>
  </block>
  </view><!-- end swipe-wrap -->

  <!-- 底部工具栏（空状态时隐藏，避免与空状态CTA重复） -->
  <view class="toolbar" wx:if="{{!(currentView === 'week' && isEmpty) && !(currentView === 'month' && monthIsEmpty)}}">
    <view class="toolbar__btn toolbar__btn--ghost" bindtap="onTextImport">
      <text class="toolbar__icon">⇧</text>
      <text>批量导入</text>
    </view>
    <view class="toolbar__btn toolbar__btn--primary" bindtap="onAddSession">
      <text class="toolbar__plus">+</text>
      <text>新建</text>
    </view>
  </view>

  <!-- 文本导入弹窗（两步） -->
  <view class="text-modal" wx:if="{{showImportModal}}" catchtouchmove="true">
    <view class="text-modal__mask" bindtap="onImportClose"></view>
    <view class="text-modal__body">
      <block wx:if="{{importStep === 1}}">
        <view class="text-modal__header">
          <text class="text-modal__title serif">粘贴课程文本</text>
          <view class="text-modal__close" bindtap="onImportClose">×</view>
        </view>
        <view class="text-modal__hint serif">每行一节课，AI 自动识别格式</view>
        <view class="text-modal__content">
          <textarea
            class="text-modal__textarea"
            placeholder="例：&#10;3.23 私教 10:30 周一 周文娟 旺君馆&#10;&#10;支持粘连格式、✓前缀、括号地点"
            value="{{importText}}"
            bindinput="onImportInput"
            maxlength="-1"
          />
        </view>
        <view class="text-modal__actions">
          <view class="text-modal__btn" bindtap="onImportClose">取消</view>
          <view class="text-modal__btn text-modal__btn--primary" bindtap="onImportParse">解析预览</view>
        </view>
      </block>

      <block wx:else>
        <view class="text-modal__header">
          <text class="text-modal__title serif">导入预览</text>
          <view class="text-modal__close" bindtap="onImportClose">×</view>
        </view>
        <view class="import-summary">
          <text class="serif">{{importTotalCount}} 节</text>
          <text class="import-summary__sub" wx:if="{{importSkippedCount > 0}}"> · 跳过 {{importSkippedCount}}</text>
          <text class="import-summary__sub" wx:if="{{importErrorCount > 0}}"> · 失败 {{importErrorCount}}</text>
        </view>
        <view class="import-switch" bindtap="onImportToggleClear">
          <switch checked="{{importClearExisting}}" color="#1F1D1A" />
          <text class="import-switch__label">导入前清除对应日期旧数据</text>
        </view>
        <scroll-view class="import-list" scroll-y="true">
          <view class="import-group" wx:for="{{importParsedGroups}}" wx:key="date" wx:for-index="gIdx">
            <text class="import-group__title">{{item.dateLabel}} · {{item.count}}节</text>
            <view
              class="import-item {{innerItem.checked ? '' : 'import-item--unchecked'}}"
              wx:for="{{item.items}}"
              wx:for-item="innerItem"
              wx:for-index="iIdx"
              wx:key="id"
              bindtap="onImportToggleItem"
              data-gidx="{{gIdx}}"
              data-iidx="{{iIdx}}"
            >
              <view class="import-item__check {{innerItem.checked ? 'import-item__check--on' : ''}}"></view>
              <text class="import-item__text {{innerItem.status === 'completed' ? 'import-item__text--done' : ''}}">{{innerItem.displayText}}</text>
              <text class="import-item__badge" wx:if="{{innerItem.status === 'completed'}}">完成</text>
            </view>
          </view>
        </scroll-view>
        <view class="text-modal__actions">
          <view class="text-modal__btn" bindtap="onImportBack">返回</view>
          <view class="text-modal__btn text-modal__btn--primary" bindtap="onImportConfirm">导入 {{importCheckedCount}} 节</view>
        </view>
      </block>
    </view>
  </view>
</view>
