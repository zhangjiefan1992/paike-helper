.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* Header */
.header {
  padding: var(--spacing-md) var(--spacing-lg) var(--spacing-sm);
}
.header__top {
  display: flex;
  align-items: center;
}
.header__nav {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
}
.header__action {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.header__action-icon {
  width: 40rpx;
  height: 40rpx;
}
.header__arrow {
  font-size: 36rpx;
  color: var(--text-muted);
  padding: var(--spacing-xs);
}
.header__range {
  font-size: var(--font-title-md);
  font-weight: 600;
  color: var(--text-primary);
}
.stats {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: 6rpx;
}
.stats__item {
  font-size: var(--font-caption);
  color: var(--text-secondary);
}
.stats__item--completed { color: var(--color-completed); }
.stats__item--cancelled { color: var(--color-cancelled); }
.stats__detail {
  font-size: var(--font-caption);
  color: var(--color-primary);
  margin-left: auto;
  font-weight: 500;
}

/* Grid Table */
.grid-table {
  display: flex;
  flex-direction: column;
  margin: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

/* Grid Header */
.grid-header {
  display: flex;
  background: var(--color-primary);
}
.grid-corner {
  width: 64rpx;
  flex-shrink: 0;
}
.grid-day-head {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
}
.grid-day-head--today {
  background: var(--color-primary-dark);
}
.grid-day-head__weekday {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.2;
}
.grid-day-head--today .grid-day-head__weekday {
  color: rgba(255, 255, 255, 0.85);
}
.grid-day-head__date {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
}

/* Grid Row */
.grid-row {
  display: flex;
  background: var(--bg-card);
}
.grid-row + .grid-row {
  border-top: 1rpx solid var(--bg-hairline);
}

/* Period Column */
.grid-period {
  width: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 10rpx;
  background: var(--bg-input);
}
.grid-period__name {
  font-size: 18rpx;
  font-weight: 500;
  color: var(--text-muted);
}

/* Grid Cell */
.grid-cell {
  flex: 1;
  min-height: 110rpx;
  padding: 4rpx 3rpx;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}
.grid-cell + .grid-cell {
  border-left: 1rpx solid var(--bg-hairline);
}
.grid-cell--today {
  background: var(--color-primary-light);
}

/* Grid Card — compact session card */
.grid-card {
  border-radius: 4rpx;
  padding: 3rpx 6rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.grid-card__time {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.grid-card__course {
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.grid-card__name {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Toolbar */
.toolbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  background: var(--bg-card);
  box-shadow: 0 -2rpx 12rpx rgba(28, 28, 28, 0.04);
  z-index: 10;
}
.toolbar__btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  height: 80rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-body-sm);
}
.toolbar__btn--outline {
  border: 2rpx solid var(--color-primary);
  background: var(--bg-card);
}
.toolbar__btn--primary {
  background: var(--color-primary);
}
.toolbar__btn-icon {
  width: 32rpx;
  height: 32rpx;
}
.toolbar__btn-plus {
  font-size: 32rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
.toolbar__btn-text {
  font-size: var(--font-body-sm);
  color: var(--color-primary);
  font-weight: 500;
}
.toolbar__btn-text--white {
  color: #fff;
}

/* Text import modal */
.text-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.text-modal__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay);
}

.text-modal__body {
  position: relative;
  width: 85%;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.text-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  border-bottom: 2rpx solid var(--bg-input, #E8E4DF);
}

.text-modal__title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}

.text-modal__close {
  font-size: var(--font-xl);
  color: var(--text-light);
  padding: 0 var(--spacing-xs);
}

.text-modal__content {
  flex: 1;
  padding: var(--spacing-md) var(--spacing-lg);
  overflow-y: auto;
  max-height: 60vh;
}

.text-modal__textarea {
  width: 100%;
  height: 500rpx;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: 1.8;
  padding: var(--spacing-sm);
  background: var(--bg-input, #F5F3EF);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.text-modal__actions {
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  border-top: 2rpx solid var(--bg-input, #E8E4DF);
  justify-content: flex-end;
}

.text-modal__btn {
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.text-modal__btn--primary {
  background: var(--color-primary);
  color: #fff;
}

/* 导入确认列表 */
.import-summary {
  padding: var(--spacing-xs) 0;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.import-summary__text {
  color: var(--color-primary);
  font-weight: 600;
}

.import-summary__skip {
  color: var(--text-light);
}

.import-summary__err {
  color: var(--color-cancelled, #D4CEC8);
}

.import-switch {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) 0;
  border-bottom: 2rpx solid var(--bg-input, #E8E4DF);
}

.import-switch__label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.import-list {
  max-height: 50vh;
}

.import-group {
  margin-top: var(--spacing-sm);
}

.import-group__header {
  padding: var(--spacing-xs) 0;
  border-bottom: 1rpx solid var(--bg-input, #E8E4DF);
}

.import-group__title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
}

.import-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: 12rpx 0;
}

.import-item--unchecked {
  opacity: 0.4;
}

.import-item__check {
  flex-shrink: 0;
}

.import-item__checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--text-light);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}

.import-item__checkbox--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.import-item__text {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
}

.import-item__text--completed {
  color: var(--color-completed, #7BAF8A);
}

.import-item__badge {
  font-size: 20rpx;
  color: var(--color-completed, #7BAF8A);
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--color-completed, #7BAF8A);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

