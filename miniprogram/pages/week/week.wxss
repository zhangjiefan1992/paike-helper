.week-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 160rpx;
  overflow-x: hidden;
}

.wv-swipe-wrap {
  will-change: transform;
}

.wv-swipe-wrap--animating {
  transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ===== Header ===== */
.wv-header {
  padding: 36rpx 40rpx 28rpx;
  background: var(--bg-card);
}

.wv-header__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wv-header__date {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -1rpx;
}

.wv-header__today-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #6366F1;
  background: rgba(99, 102, 241, 0.08);
  padding: 12rpx 28rpx;
  border-radius: 16rpx;
}

.wv-header__nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--bg-hairline);
}

.wv-header__range {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-muted);
}

.wv-header__arrows {
  display: flex;
  gap: 8rpx;
}

.wv-header__arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--bg-hairline);
  font-size: 28rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== Summary ===== */
.wv-summary {
  display: flex;
  padding: 28rpx 40rpx;
  gap: 32rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--bg-hairline);
}

.wv-summary__item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wv-summary__num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1;
}

.wv-summary__label {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 500;
  line-height: 1.3;
}

.wv-summary__divider {
  width: 1rpx;
  background: var(--bg-hairline);
  align-self: stretch;
}

/* ===== Week Grid ===== */
.wv-grid {
  margin-top: 20rpx;
  padding: 0 20rpx;
  white-space: nowrap;
}

.wv-grid__inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 20rpx;
}

.wv-day {
  width: 220rpx;
  flex-shrink: 0;
  display: inline-block;
  vertical-align: top;
  white-space: normal;
}

.wv-day--today {
  width: 240rpx;
}

/* ===== Day Header ===== */
.wv-day__head {
  text-align: center;
  padding: 20rpx 0 16rpx;
}

.wv-day__name {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 500;
}

.wv-day__num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 8rpx;
}

.wv-day--today .wv-day__num {
  background: #6366F1;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
}

.wv-day--today .wv-day__name {
  color: #6366F1;
  font-weight: 600;
}

/* ===== Day Body ===== */
.wv-day__body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 0 4rpx 32rpx;
}

.wv-day--today .wv-day__body {
  background: rgba(99, 102, 241, 0.06);
  border-radius: 32rpx;
  padding: 16rpx 12rpx 32rpx;
  margin: 0 -4rpx;
}

/* ===== Cards ===== */
.wv-card {
  border-radius: 28rpx;
  padding: 20rpx 22rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
  border: 2rpx solid transparent;
}

.wv-card--done {
  opacity: 0.6;
}

.wv-card__header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.wv-card__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.wv-card__time {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.5rpx;
}

.wv-card__type {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 8rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wv-card__member {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wv-card__location {
  display: block;
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wv-card__footer {
  margin-top: 16rpx;
}

.wv-card__status {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.7);
}

.wv-card__status--completed {
  color: #10B981;
}

.wv-card__status--scheduled {
  color: var(--text-muted);
}

/* ===== Theme: Candy Gradient overrides ===== */
.theme-candy-gradient .wv-header__today-btn {
  color: #6C63FF;
  background: rgba(108, 99, 255, 0.08);
}

.theme-candy-gradient .wv-day--today .wv-day__num {
  background: #6C63FF;
  box-shadow: 0 6rpx 20rpx rgba(108, 99, 255, 0.35);
}

.theme-candy-gradient .wv-day--today .wv-day__name {
  color: #6C63FF;
}

.theme-candy-gradient .wv-day--today .wv-day__body {
  background: rgba(108, 99, 255, 0.06);
}

.theme-candy-gradient .wv-card__time,
.theme-candy-gradient .wv-card__type,
.theme-candy-gradient .wv-card__member,
.theme-candy-gradient .wv-card__location {
  color: #fff;
}

.theme-candy-gradient .wv-card__time { opacity: 0.85; }
.theme-candy-gradient .wv-card__member { opacity: 0.9; }
.theme-candy-gradient .wv-card__location { opacity: 0.7; }

.theme-candy-gradient .wv-card__status {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

.theme-candy-gradient .wv-card::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 60%;
  height: 100%;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 0 0 0 160rpx;
  pointer-events: none;
}

/* ===== Theme: Soft Color overrides ===== */
.theme-soft-color .wv-header__today-btn {
  color: #4F8CFF;
  background: rgba(79, 140, 255, 0.08);
}

.theme-soft-color .wv-day--today .wv-day__num {
  background: #4F8CFF;
  box-shadow: 0 4rpx 16rpx rgba(79, 140, 255, 0.3);
}

.theme-soft-color .wv-day--today .wv-day__name {
  color: #4F8CFF;
}

.theme-soft-color .wv-day--today .wv-day__body {
  background: rgba(79, 140, 255, 0.06);
}

.theme-soft-color .wv-card--pilates .wv-card__type { color: #3B52A5; }
.theme-soft-color .wv-card--yoga .wv-card__type { color: #B85C1F; }
.theme-soft-color .wv-card--fitness .wv-card__type { color: #1A7A4C; }
.theme-soft-color .wv-card--group .wv-card__type { color: #7C3AED; }

/* ===== Empty Day ===== */
.wv-day-empty {
  text-align: center;
  padding: 56rpx 12rpx;
}

.wv-day-empty__circle {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  border: 2rpx dashed var(--bg-hairline);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12rpx;
  font-size: 36rpx;
  color: var(--text-muted);
}

.wv-day-empty__text {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 500;
}

/* ===== Toolbar ===== */
.toolbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  background: var(--bg-card);
  box-shadow: 0 -2rpx 12rpx rgba(28, 28, 28, 0.04);
  z-index: 10;
}

.toolbar__btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  height: 80rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-body-sm);
}

.toolbar__btn--outline {
  border: 2rpx solid var(--color-primary);
  background: var(--bg-card);
}

.toolbar__btn--primary {
  background: var(--color-primary);
}

.toolbar__btn-icon {
  width: 32rpx;
  height: 32rpx;
}

.toolbar__btn-plus {
  font-size: 32rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.toolbar__btn-text {
  font-size: var(--font-body-sm);
  color: var(--color-primary);
  font-weight: 500;
}

.toolbar__btn-text--white {
  color: #fff;
}

/* ===== Text Import Modal ===== */
.text-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-modal__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay, rgba(0, 0, 0, 0.5));
}

.text-modal__body {
  position: relative;
  width: 85%;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.text-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  border-bottom: 2rpx solid var(--bg-input, #E8E4DF);
}

.text-modal__title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}

.text-modal__close {
  font-size: var(--font-xl);
  color: var(--text-light);
  padding: 0 var(--spacing-xs);
}

.text-modal__content {
  flex: 1;
  padding: var(--spacing-md) var(--spacing-lg);
  overflow-y: auto;
  max-height: 60vh;
}

.text-modal__textarea {
  width: 100%;
  height: 500rpx;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: 1.8;
  padding: var(--spacing-sm);
  background: var(--bg-input, #F5F3EF);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.text-modal__actions {
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  border-top: 2rpx solid var(--bg-input, #E8E4DF);
  justify-content: flex-end;
}

.text-modal__btn {
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.text-modal__btn--primary {
  background: var(--color-primary);
  color: #fff;
}

/* Import confirm list */
.import-summary {
  padding: var(--spacing-xs) 0;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.import-summary__text {
  color: var(--color-primary);
  font-weight: 600;
}

.import-summary__skip {
  color: var(--text-light);
}

.import-summary__err {
  color: var(--color-cancelled, #D4CEC8);
}

.import-switch {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) 0;
  border-bottom: 2rpx solid var(--bg-input, #E8E4DF);
}

.import-switch__label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.import-list {
  max-height: 50vh;
}

.import-group {
  margin-top: var(--spacing-sm);
}

.import-group__header {
  padding: var(--spacing-xs) 0;
  border-bottom: 1rpx solid var(--bg-input, #E8E4DF);
}

.import-group__title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
}

.import-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: 12rpx 0;
}

.import-item--unchecked {
  opacity: 0.4;
}

.import-item__check {
  flex-shrink: 0;
}

.import-item__checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--text-light);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}

.import-item__checkbox--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.import-item__text {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
}

.import-item__text--completed {
  color: var(--color-completed, #7BAF8A);
}

.import-item__badge {
  font-size: 20rpx;
  color: var(--color-completed, #7BAF8A);
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--color-completed, #7BAF8A);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}
