.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 180rpx;
  overflow-x: hidden;
}

.swipe-wrap { will-change: transform; }
.swipe-wrap--animating {
  transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}

/* === Header === */
.hdr {
  padding: 44rpx 56rpx 24rpx;
}
.hdr__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.hdr__title {
  font-size: 56rpx;
  font-weight: 400;
  line-height: 1;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.hdr__today {
  font-size: 24rpx;
  color: var(--ink-2);
  letter-spacing: 0.08em;
  padding: 12rpx 16rpx;
}
.hdr__nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--rule);
}
.hdr__range {
  font-weight: 300;
  font-size: 26rpx;
  color: var(--ink-3);
  letter-spacing: 0.02em;
}
.hdr__arrows {
  display: flex;
  gap: 4rpx;
}
.hdr__arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 32rpx;
  color: var(--ink-3);
}
.hdr__arrow:active {
  background: var(--rule-soft);
  color: var(--ink);
}

/* === Summary === */
.summary {
  display: flex;
  align-items: center;
  padding: 16rpx 56rpx 36rpx;
  gap: 36rpx;
}
.summary__item {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.summary__num {
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.summary__lbl {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.08em;
}
.summary__div {
  width: 1rpx;
  height: 32rpx;
  background: var(--rule);
}

/* === Empty === */
.empty {
  text-align: center;
  padding: 200rpx 64rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty__mark {
  width: 80rpx;
  height: 1rpx;
  background: var(--ink-4);
  opacity: 0.5;
  margin-bottom: 56rpx;
}
.empty__title {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--ink);
  letter-spacing: -0.01em;
  margin-bottom: 14rpx;
  line-height: 1.2;
}
.empty__hint {
  font-style: italic;
  font-weight: 300;
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 56rpx;
  line-height: 1.6;
}
.empty__cta {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 48rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: 26rpx;
  letter-spacing: 0.06em;
  border-radius: 999rpx;
}
.empty__cta:active { background: var(--ink-2); }
.empty__cta-arrow { font-family: var(--display); }
.empty__alt {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 0.04em;
  text-decoration: underline;
}

/* === Week Grid === */
.grid {
  white-space: nowrap;
  border-top: 1rpx solid var(--rule-soft);
}
.grid__inner {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 8rpx;
}
.day {
  flex: 0 0 auto;
  width: 240rpx;
  white-space: normal;
}
.day--today { width: 280rpx; }

.day__head {
  text-align: center;
  padding: 8rpx 0 20rpx;
  border-bottom: 1rpx solid var(--rule-soft);
  margin-bottom: 16rpx;
}
.day__name {
  display: block;
  font-size: 20rpx;
  color: var(--ink-4);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}
.day__num {
  display: block;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--ink-2);
  letter-spacing: -0.01em;
}
.day__count {
  display: block;
  font-weight: 400;
  font-size: 20rpx;
  color: var(--ink-4);
  letter-spacing: 0.04em;
  margin-top: 8rpx;
}
.day--today .day__name { color: var(--ink); font-weight: 500; }
.day--today .day__num { color: var(--ink); font-weight: 400; }
.day--today .day__num::after {
  content: "";
  display: block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin: 12rpx auto 0;
}

.day__body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 0 4rpx;
}
.day--today .day__body {
  background: rgba(74, 124, 89, 0.04);
  border-radius: 12rpx;
  padding: 12rpx 8rpx;
  margin: 0 -4rpx;
}

/* === Cards === */
.card {
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(74, 124, 89, 0.05);
  border: 1rpx solid rgba(74, 124, 89, 0.12);
}
.card--done { opacity: 0.5; }
.card__head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}
.card__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}
.card__time {
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 0.02em;
  font-weight: 400;
}
.card__type {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ink);
  margin-bottom: 4rpx;
  letter-spacing: -0.005em;
}
.card__member {
  display: block;
  font-size: 22rpx;
  color: var(--ink-2);
  margin-bottom: 2rpx;
}
.card__loc {
  display: block;
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 0.02em;
}
.card__status {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 18rpx;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.card__status--completed { color: var(--color-primary); }

/* === Empty Day === */
.day-empty {
  text-align: center;
  padding: 36rpx 0;
}
.day-empty__mark {
  display: inline-block;
  width: 32rpx;
  height: 1rpx;
  background: var(--ink-5);
  opacity: 0.6;
}
.day-empty:active .day-empty__mark {
  width: 48rpx;
  background: var(--color-primary);
  opacity: 1;
}

/* === Bottom toolbar === */
.toolbar {
  position: fixed;
  bottom: env(safe-area-inset-bottom);
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 56rpx;
  background: linear-gradient(to bottom, transparent, var(--paper) 30%);
  z-index: 50;
}
.toolbar__btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  font-size: 28rpx;
  letter-spacing: 0.06em;
  border-radius: 999rpx;
}
.toolbar__btn--ghost {
  background: var(--paper);
  color: var(--ink-2);
  border: 1rpx solid var(--ink-3);
}
.toolbar__btn--ghost:active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}
.toolbar__btn--primary {
  background: var(--ink);
  color: var(--paper);
}
.toolbar__btn--primary:active { background: var(--ink-2); }
.toolbar__plus {
  font-size: 32rpx;
  font-weight: 300;
}

/* === Text import modal === */
.text-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
}
.text-modal__mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(31, 29, 26, 0.4);
}
.text-modal__body {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 44rpx 44rpx calc(env(safe-area-inset-bottom) + 36rpx);
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}
.text-modal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.text-modal__title {
  font-size: 44rpx;
  color: var(--ink);
  font-weight: 400;
  letter-spacing: -0.01em;
}
.text-modal__close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-3);
}
.text-modal__hint {
  font-style: italic;
  font-weight: 300;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 24rpx;
}
.text-modal__content {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 28rpx;
  min-height: 360rpx;
}
.text-modal__textarea {
  width: 100%;
  min-height: 360rpx;
  padding: 24rpx;
  background: var(--rule-soft);
  border: 1rpx solid var(--rule);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
  box-sizing: border-box;
}
.text-modal__actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.text-modal__btn {
  padding: 20rpx 44rpx;
  font-size: 27rpx;
  color: var(--ink);
  border: 1rpx solid var(--ink-2);
  border-radius: 999rpx;
  letter-spacing: 0.06em;
}
.text-modal__btn--primary {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

/* === Import preview list === */
.import-summary {
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 16rpx;
  letter-spacing: 0.01em;
}
.import-summary__sub {
  font-size: 22rpx;
  color: var(--ink-3);
}
.import-switch {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid var(--rule);
}
.import-switch__label {
  font-size: 24rpx;
  color: var(--ink-2);
}
.import-list {
  flex: 1;
  max-height: 50vh;
  margin-bottom: 24rpx;
}
.import-group {
  margin-bottom: 24rpx;
}
.import-group__title {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.import-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--rule-soft);
}
.import-item__check {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  border: 1rpx solid var(--ink-3);
  flex-shrink: 0;
  position: relative;
}
.import-item__check--on {
  background: var(--ink);
  border-color: var(--ink);
}
.import-item__check--on::after {
  content: "✓";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 18rpx;
  color: var(--paper);
}
.import-item--unchecked .import-item__text {
  color: var(--ink-4);
  text-decoration: line-through;
}
.import-item__text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
}
.import-item__text--done { color: var(--color-primary); }
.import-item__badge {
  font-size: 18rpx;
  color: var(--color-primary);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
