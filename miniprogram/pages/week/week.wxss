.page {
  height: 100vh;
  background: var(--paper);
  padding-bottom: 0;
  overflow: hidden;
}

.swipe-wrap { will-change: transform; }
.swipe-wrap--animating {
  transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}

/* === Header (dark bg, white text) === */
.hdr {
  padding: 32rpx 40rpx 20rpx;
  background: var(--hdr-bg);
}
.hdr__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.hdr__title {
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
  color: #FFFFFF;
  letter-spacing: -0.01em;
}
.hdr__today {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  letter-spacing: 0.08em;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,0.25);
  border-radius: 8rpx;
}
.hdr__today:active {
  background: rgba(255,255,255,0.15);
}
.hdr__nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255,255,255,0.12);
}
.hdr__nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.seg {
  display: flex;
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
  overflow: hidden;
}
.seg__item {
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  letter-spacing: 0.06em;
}
.seg__item--active {
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-weight: 600;
}
.hdr__stats {
  font-size: 24rpx;
  color: rgba(255,255,255,0.65);
  letter-spacing: 0.02em;
}
.hdr__arrows {
  display: flex;
  gap: 4rpx;
}
.hdr__arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 32rpx;
  color: rgba(255,255,255,0.7);
}
.hdr__arrow:active {
  background: rgba(255,255,255,0.1);
  color: #FFFFFF;
}

/* === Empty === */
.empty {
  text-align: center;
  padding: 200rpx 64rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty__mark {
  width: 80rpx;
  height: 1rpx;
  background: var(--ink-4);
  opacity: 0.5;
  margin-bottom: 56rpx;
}
.empty__title {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--ink);
  letter-spacing: -0.01em;
  margin-bottom: 14rpx;
  line-height: 1.2;
}
.empty__hint {
  font-style: italic;
  font-weight: 300;
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 56rpx;
  line-height: 1.6;
}
.empty__cta {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 48rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: 26rpx;
  letter-spacing: 0.06em;
  border-radius: 999rpx;
}
.empty__cta:active { background: var(--ink-2); }
.empty__cta-arrow { font-family: var(--display); }
.empty__alt {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 0.04em;
  text-decoration: underline;
}

/* === Theme: soft-color (studio neutral) === */
.theme-soft-color {
  background: #F5F1EA;
  --paper: #FFFDF8;
  --ink: #211B17;
  --ink-2: #4B4139;
  --ink-3: #85796D;
  --ink-4: #B7AA9C;
  --rule: #E4DCCF;
  --rule-soft: #F0E9DF;
  --hdr-bg: #211B17;
  --grid-head-bg: #F1EAE0;
  --grid-period-bg: #FAF6EF;
  --grid-border: #E3DBCE;
  --grid-today: #F6EBDD;
  --period-accent: #A93D4F;
  --period-text: #3F342D;
}

/* === Theme: class-plan (cool tones) === */
.theme-class-plan {
  background: #F7F8FC;
  --paper: #FBFCFF;
  --ink: #1E2352;
  --ink-2: #4A5070;
  --ink-3: #8088A8;
  --ink-4: #B0B6CC;
  --rule: #E2E7F2;
  --rule-soft: #F1F4FA;
  --hdr-bg: #182044;
  --grid-head-bg: #F1F4FA;
  --grid-period-bg: #F7F9FD;
  --grid-border: #E2E7F2;
  --grid-today: #EEF5FF;
  --period-accent: #3154D4;
  --period-text: #25305C;
}

/* === Period Board Grid === */
.cp-grid {
  overflow: hidden;
  background: var(--paper);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.9);
}
.cp-grid__head {
  display: grid;
  grid-template-columns: 108rpx repeat(7, minmax(0, 1fr));
  background: var(--grid-head-bg);
  border-top: 1rpx solid var(--grid-border);
  border-bottom: 1rpx solid var(--grid-border);
}
.cp-grid__time-head {
  background: var(--grid-period-bg);
  border-right: 1rpx solid var(--grid-border);
}
.cp-grid__day-head {
  text-align: center;
  padding: 14rpx 0 10rpx;
  border-left: 1rpx solid var(--grid-border);
}
.cp-grid__day-head:active { background: #E9EEF9; }
.cp-grid__day-head--today { background: #EAF1FF; }
.cp-grid__day-head--today .cp-grid__weekday { color: var(--ink); font-weight: 700; }
.cp-grid__day-head--today .cp-grid__daynum { color: var(--ink-2); }
.cp-grid__weekday {
  display: block;
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 0.06em;
  font-weight: 600;
}
.cp-grid__daynum {
  display: block;
  font-size: 19rpx;
  color: var(--ink-4);
  margin-top: 2rpx;
}

.cp-grid__body {
  border-bottom: 1rpx solid var(--grid-border);
}
.cp-row {
  display: grid;
  grid-template-columns: 108rpx repeat(7, minmax(0, 1fr));
  border-top: 1rpx solid var(--grid-border);
  overflow: hidden;
}
.cp-row__period {
  background: var(--grid-period-bg);
  color: var(--period-text);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 6rpx;
  box-sizing: border-box;
  border-right: 1rpx solid var(--grid-border);
  position: relative;
}
.cp-row__period::before {
  content: '';
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 5rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: var(--period-accent);
  opacity: 0.65;
}
.cp-row__label {
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.cp-row__range {
  font-size: 18rpx;
  line-height: 1;
  color: var(--ink-3);
  white-space: nowrap;
}
.cp-cell {
  min-width: 0;
  position: relative;
  padding: 9rpx 5rpx;
  border-left: 1rpx solid var(--grid-border);
  background: linear-gradient(180deg, #FFFFFF 0%, var(--paper) 100%);
  box-sizing: border-box;
  overflow: hidden;
}
.cp-cell--today {
  background: var(--grid-today);
}
.cp-cell:active {
  background: #F0F4FA;
}
.cp-cell__empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: transparent;
  font-size: 24rpx;
}
.cp-cell:active .cp-cell__empty {
  color: var(--ink-4);
}

.cp-card {
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  border-radius: 8rpx;
  padding: 6rpx 7rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-left: 0 solid transparent;
  box-shadow: 0 6rpx 14rpx rgba(24, 32, 68, 0.12);
}
.cp-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--card-accent, rgba(255,255,255,0.42));
  opacity: 0.9;
}
.cp-card::after {
  content: '';
  position: absolute;
  left: 6rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: rgba(255,255,255,0.55);
}
.cp-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.cp-card--done {
  opacity: 0.68;
  filter: saturate(0.82);
}
.cp-card__time {
  display: block;
  font-size: 18rpx;
  font-weight: 700;
  opacity: 0.9;
  line-height: 1;
  white-space: nowrap;
  position: relative;
  z-index: 1;
}
.cp-card__name {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.05;
  position: relative;
  z-index: 1;
}
.cp-card__meta {
  display: block;
  margin-top: 2rpx;
  font-size: 14rpx;
  opacity: 0.78;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  position: relative;
  z-index: 1;
}
.cp-card--minimal {
  padding-top: 5rpx;
  padding-bottom: 5rpx;
}
.cp-card--minimal .cp-card__name {
  margin-top: 1rpx;
}
.cp-card--detailed {
  padding-top: 7rpx;
  padding-bottom: 7rpx;
}
.cp-card--detailed .cp-card__meta {
  margin-top: 3rpx;
  font-size: 15rpx;
  line-height: 1.1;
}
/* === Empty Day === */
.day-empty {
  text-align: center;
  padding: 24rpx 0;
}
.day-empty__mark {
  display: inline-block;
  width: 24rpx;
  height: 1rpx;
  background: var(--ink-5, var(--ink-4));
  opacity: 0.4;
}
.day-empty:active .day-empty__mark {
  width: 36rpx;
  background: var(--color-primary);
  opacity: 1;
}

/* === Bottom toolbar === */
.toolbar {
  position: fixed;
  bottom: env(safe-area-inset-bottom);
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 26rpx 56rpx 24rpx;
  background: rgba(251,252,255,0.96);
  z-index: 50;
  border-top: 1rpx solid rgba(226,231,242,0.72);
  box-shadow: 0 -10rpx 28rpx rgba(24, 32, 68, 0.06);
}
.toolbar::before {
  display: none;
}
.toolbar__btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  font-size: 28rpx;
  letter-spacing: 0.06em;
  border-radius: 999rpx;
  font-weight: 600;
}
.toolbar__btn--ghost {
  background: #FFFFFF;
  color: var(--ink);
  border: 2rpx solid rgba(24,32,68,0.72);
}
.toolbar__btn--ghost:active {
  background: #F1F4FA;
  color: var(--ink);
  border-color: var(--ink);
}
.toolbar__btn--primary {
  background: var(--ink);
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(24,32,68,0.18);
}
.toolbar__btn--primary:active { background: var(--ink-2); }
.toolbar__icon {
  font-size: 34rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}
.toolbar__plus {
  font-size: 32rpx;
  font-weight: 500;
}

/* === Text import modal === */
.text-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
}
.text-modal__mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(31, 29, 26, 0.4);
}
.text-modal__body {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 44rpx 44rpx calc(env(safe-area-inset-bottom) + 36rpx);
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}
.text-modal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.text-modal__title {
  font-size: 44rpx;
  color: var(--ink);
  font-weight: 400;
  letter-spacing: -0.01em;
}
.text-modal__close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-3);
}
.text-modal__hint {
  font-style: italic;
  font-weight: 300;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 24rpx;
}
.text-modal__content {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 28rpx;
  min-height: 360rpx;
}
.text-modal__textarea {
  width: 100%;
  min-height: 360rpx;
  padding: 24rpx;
  background: var(--rule-soft);
  border: 1rpx solid var(--rule);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
  box-sizing: border-box;
}
.text-modal__actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.text-modal__btn {
  padding: 20rpx 44rpx;
  font-size: 27rpx;
  color: var(--ink);
  border: 1rpx solid var(--ink-2);
  border-radius: 999rpx;
  letter-spacing: 0.06em;
}
.text-modal__btn--primary {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

/* === Import preview list === */
.import-summary {
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 16rpx;
  letter-spacing: 0.01em;
}
.import-summary__sub {
  font-size: 22rpx;
  color: var(--ink-3);
}
.import-switch {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid var(--rule);
}
.import-switch__label {
  font-size: 24rpx;
  color: var(--ink-2);
}
.import-list {
  flex: 1;
  max-height: 50vh;
  margin-bottom: 24rpx;
}
.import-group {
  margin-bottom: 24rpx;
}
.import-group__title {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.import-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--rule-soft);
}
.import-item__check {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  border: 1rpx solid var(--ink-3);
  flex-shrink: 0;
  position: relative;
}
.import-item__check--on {
  background: var(--ink);
  border-color: var(--ink);
}
.import-item__check--on::after {
  content: "✓";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 18rpx;
  color: var(--paper);
}
.import-item--unchecked .import-item__text {
  color: var(--ink-4);
  text-decoration: line-through;
}
.import-item__text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
}
.import-item__text--done { color: var(--color-primary); }
.import-item__badge {
  font-size: 18rpx;
  color: var(--color-primary);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* === Month view === */
.month-grid {
  padding: 0;
}
.month-grid__head {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: var(--grid-head-bg);
  padding: 16rpx 0;
}
.month-grid__weekday {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
  letter-spacing: 0.06em;
}
.month-grid__body {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}
.month-cell {
  aspect-ratio: 1 / 1.1;
  border-bottom: 1rpx solid var(--grid-border);
  border-right: 1rpx solid var(--grid-border);
  padding: 8rpx 8rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--paper);
}
.month-cell:nth-child(7n) { border-right: none; }
.month-cell--today { background: var(--grid-today); }
.month-cell--outside { background: var(--rule-soft); }
.month-cell--outside .month-cell__day { color: var(--ink-4); }
.month-cell--outside .month-dots { opacity: 0.4; }
.month-cell__day {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1;
  margin-bottom: 8rpx;
}
.month-cell__day--today {
  background: var(--ink);
  color: var(--paper);
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.month-dots {
  display: flex;
  gap: 6rpx;
  flex-wrap: wrap;
  justify-content: center;
}
.month-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.month-count {
  font-size: 18rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}
