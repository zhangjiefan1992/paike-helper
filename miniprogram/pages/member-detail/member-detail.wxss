.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部信息 */
.profile {
  background: var(--bg-card);
  padding: var(--spacing-lg);
  margin: var(--spacing-md);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.profile__header {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.profile__info {
  flex: 1;
  min-width: 0;
}

.profile__name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.profile__phone {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.profile__edit {
  font-size: var(--font-sm);
  color: var(--color-primary);
  padding: var(--spacing-xs) var(--spacing-md);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.profile__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--spacing-sm);
  gap: var(--spacing-xs);
}

.profile__notes {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: var(--spacing-sm);
  line-height: 1.5;
}

/* 统计卡片 */
.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-sm);
  padding: 0 var(--spacing-md);
  margin-top: var(--spacing-sm);
}

.stat-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-md);
  text-align: center;
}

.stat-card__value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-card__label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 时间轴区域 */
.timeline-section {
  padding: var(--spacing-lg) var(--spacing-md);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
}

/* 月份分组 */
.month-group {
  margin-bottom: var(--spacing-md);
}

.month-header {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.month-label {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
}

.month-count {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-right: var(--spacing-sm);
}

.month-arrow {
  font-size: var(--font-sm);
  color: var(--text-light);
  transition: transform 0.2s;
}

.month-arrow--collapsed {
  transform: rotate(-90deg);
}

/* 时间轴记录 */
.month-records {
  padding-left: var(--spacing-md);
  margin-top: var(--spacing-sm);
}

.timeline-item {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: var(--spacing-md);
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.timeline-dot--completed {
  background: var(--color-completed);
}

.timeline-dot--cancelled {
  background: var(--color-cancelled);
}

.timeline-dot--noshow {
  background: var(--color-noshow);
}

.timeline-dot--scheduled {
  background: var(--color-scheduled);
}

.timeline-line {
  position: absolute;
  left: 8rpx;
  top: 36rpx;
  bottom: 0;
  width: 4rpx;
  background: var(--bg-input, #E8E4DF);
}

.timeline-content {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  box-shadow: var(--shadow-card);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-date {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.record-status {
  font-size: var(--font-xs);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
}

.record-status--completed {
  color: var(--color-completed);
  background: rgba(129, 199, 132, 0.15);
}

.record-status--cancelled {
  color: var(--color-cancelled);
  background: rgba(224, 224, 224, 0.3);
}

.record-status--noshow {
  color: var(--color-noshow);
  background: rgba(255, 183, 77, 0.15);
}

.record-status--scheduled {
  color: var(--color-scheduled);
  background: rgba(100, 181, 246, 0.15);
}

.record-body {
  margin-top: var(--spacing-xs);
}

.record-type {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}

.record-time {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}

.record-location {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  display: block;
  margin-top: 2rpx;
}

.record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: var(--spacing-xs);
}

.record-tag {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: rgba(242, 139, 130, 0.12);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
}

/* 展开内容 */
.record-notes {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 2rpx solid var(--bg-input, #E8E4DF);
}

.record-notes__label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  display: block;
  margin-bottom: 4rpx;
}

.record-notes__text {
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: 1.5;
}

.record-photos {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-sm);
}

.record-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
}

.record-expand-hint {
  text-align: center;
  margin-top: var(--spacing-xs);
}

.record-expand-hint text {
  font-size: var(--font-xs);
  color: var(--color-primary);
}
