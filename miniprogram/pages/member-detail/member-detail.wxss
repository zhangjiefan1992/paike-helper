.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 60rpx;
}

/* === Profile === */
.profile {
  padding: 56rpx 56rpx 72rpx;
}
.profile__accent {
  width: 56rpx;
  height: 4rpx;
  margin-bottom: 44rpx;
  border-radius: 2rpx;
}
.profile__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.profile__name {
  font-size: 76rpx;
  font-weight: 400;
  line-height: 1.1;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.profile__actions {
  display: flex;
  gap: 8rpx;
}
.profile__action {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 0.06em;
  padding: 16rpx 16rpx;
}
.profile__action:active { color: var(--ink); }
.profile__meta {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 0.02em;
  line-height: 1.8;
}
.dot-sep {
  margin: 0 12rpx;
  color: var(--ink-5);
}
.profile__quote {
  font-style: italic;
  font-weight: 300;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink-2);
  margin-top: 36rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--rule);
  display: block;
}

/* === Medical alert === */
.alert {
  margin: 0 56rpx 24rpx;
  padding: 18rpx 24rpx;
  background: rgba(181, 87, 61, 0.07);
  border-radius: 12rpx;
  color: var(--warm);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  letter-spacing: 0.02em;
}
.alert__icon {
  font-size: 24rpx;
  margin-right: 12rpx;
}
.alert__label {
  font-weight: 500;
  margin-right: 12rpx;
}
.alert__kw {
  padding: 4rpx 14rpx;
  border: 1rpx solid currentColor;
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  margin-right: 8rpx;
  margin-top: 4rpx;
}

/* === Rule === */
.rule {
  height: 1rpx;
  background: var(--rule);
  margin: 56rpx 56rpx;
}

/* === Hero === */
.hero {
  padding: 16rpx 56rpx 48rpx;
}
.hero__label {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  margin-bottom: 32rpx;
}
.hero__display {
  display: flex;
  align-items: baseline;
  gap: 28rpx;
  margin-bottom: 20rpx;
}
.hero__num {
  font-size: 192rpx;
  font-weight: 300;
  line-height: 0.95;
  color: var(--ink);
  letter-spacing: -0.04em;
}
.hero__unit {
  font-size: 44rpx;
  font-weight: 300;
  color: var(--ink-3);
}
.hero__sub {
  font-size: 26rpx;
  color: var(--ink-3);
  letter-spacing: 0.02em;
  display: block;
  margin-bottom: 56rpx;
}

.hero__stats {
  display: flex;
  align-items: center;
  gap: 36rpx;
  padding-top: 36rpx;
  border-top: 1rpx solid var(--rule-soft);
}
.stat {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.stat__num {
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.stat__lbl {
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: 0.06em;
}
.stat__num-unit {
  font-family: var(--display);
  font-size: 24rpx;
  color: var(--ink-3);
  margin-left: 4rpx;
  font-weight: 400;
  letter-spacing: 0;
}
.stat__div {
  width: 1rpx;
  height: 44rpx;
  background: var(--rule);
}

.hero--empty {
  padding: 72rpx 56rpx;
  text-align: center;
}
.hero--empty__title {
  display: block;
  font-size: 44rpx;
  color: var(--ink-2);
  font-weight: 300;
  letter-spacing: -0.01em;
  margin-bottom: 12rpx;
}
.hero--empty__hint {
  display: block;
  font-size: 24rpx;
  color: var(--ink-4);
  font-style: italic;
}

/* === Section block === */
.block { padding: 0 56rpx; }
.block__title {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  margin-bottom: 40rpx;
  font-weight: 500;
}

/* === Timeline === */
.timeline {
  display: flex;
  flex-direction: column;
}
.entry {
  display: flex;
  gap: 28rpx;
  padding-bottom: 44rpx;
}
.entry:last-child { padding-bottom: 0; }
.entry__rail {
  width: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 10rpx;
  flex-shrink: 0;
}
.entry__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--ink-4);
  box-shadow: 0 0 0 2rpx var(--paper), 0 0 0 4rpx var(--ink-4);
}
.entry__dot--completed { background: var(--primary); box-shadow: 0 0 0 2rpx var(--paper), 0 0 0 4rpx var(--primary); }
.entry__dot--scheduled { background: var(--paper); box-shadow: 0 0 0 2rpx var(--paper), 0 0 0 4rpx var(--ink-3); }
.entry__dot--cancelled { opacity: 0.4; }
.entry__dot--noshow { background: #C58A3B; box-shadow: 0 0 0 2rpx var(--paper), 0 0 0 4rpx #C58A3B; }
.entry__line {
  flex: 1;
  width: 1rpx;
  background: var(--rule);
  margin: 16rpx 0 -16rpx;
}
.entry__body {
  flex: 1;
  min-width: 0;
}
.entry__head {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 10rpx;
}
.entry__date {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.entry__time {
  font-size: 22rpx;
  color: var(--ink-3);
}
.entry__status {
  margin-left: auto;
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: var(--ink-4);
}
.entry__status--completed { color: var(--primary); }
.entry__status--scheduled { color: var(--ink-2); }
.entry__status--noshow { color: #C58A3B; }
.entry__type {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 8rpx;
}
.entry__loc { color: var(--ink-3); }
.entry__focus {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}
.entry__focus-label {
  color: var(--ink-4);
  letter-spacing: 0.08em;
  margin-right: 16rpx;
  font-size: 20rpx;
}
.entry__digest {
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink-3);
  margin-top: 10rpx;
  display: block;
}

/* === Distribution === */
.bars {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-bottom: 56rpx;
}
.bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.bar__name {
  font-size: 26rpx;
  color: var(--ink-2);
  width: 130rpx;
  flex-shrink: 0;
}
.bar__track {
  flex: 1;
  height: 1rpx;
  background: var(--rule);
  position: relative;
}
.bar__fill {
  position: absolute;
  top: -2rpx;
  left: 0;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}
.bar__count {
  font-size: 26rpx;
  color: var(--ink-3);
  width: 56rpx;
  text-align: right;
}

.cloud { padding-top: 16rpx; }
.cloud__title {
  display: block;
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 28rpx;
  font-weight: 500;
}
.cloud__items {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
}
.cloud__item {
  margin-right: 28rpx;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.4;
}

/* === Medical highlight === */
.med-mark {
  color: var(--warm);
  font-weight: 500;
}

/* AI Entry — fixed bottom CTA */
.ai-entry {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--paper, #FFFDF8);
  border-top: 1rpx solid var(--rule, #E8E2D8);
  z-index: 100;
}
.ai-entry__text {
  padding: 24rpx 48rpx;
  background: var(--ink, #2C2C2C);
  color: var(--paper, #FFFDF8);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.ai-entry__text:active {
  opacity: 0.85;
}

.page__tail { height: 140rpx; }

/* === Export modal === */
.export-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
}
.export-modal__mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(31, 29, 26, 0.4);
}
.export-modal__body {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 36rpx calc(env(safe-area-inset-bottom) + 28rpx);
  height: 88vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.export-modal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.export-modal__title {
  font-size: 40rpx;
  color: var(--ink);
  font-weight: 400;
  letter-spacing: -0.01em;
}
.export-modal__close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-3);
}
.export-modal__hint {
  font-style: italic;
  font-weight: 300;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 20rpx;
}
.export-modal__text {
  flex: 1;
  width: 100%;
  font-family: var(--display);
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink);
  background: var(--rule-soft);
  border: 1rpx solid var(--rule);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  word-break: break-all;
}
.export-modal__actions {
  display: flex;
  gap: 16rpx;
}
.export-modal__btn {
  flex: 1;
  padding: 22rpx 0;
  background: var(--ink);
  color: var(--paper);
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 0.06em;
  text-align: center;
}
.export-modal__btn--ghost {
  background: transparent;
  color: var(--ink);
  border: 1rpx solid var(--ink-2);
}
