<view class="page" wx:if="{{member}}">

  <!-- Profile -->
  <view class="profile">
    <view class="profile__accent" style="background:{{accent}}"></view>
    <view class="profile__top">
      <text class="profile__name serif">{{member.name}}</text>
      <view class="profile__actions">
        <view class="profile__action" bindtap="onExport">导出</view>
        <view class="profile__action" bindtap="onEdit">编辑</view>
      </view>
    </view>
    <view class="profile__meta" wx:if="{{member.phone || member.tags.length}}">
      <text wx:if="{{member.phone}}" class="profile__phone">{{member.phone}}</text>
      <text wx:if="{{member.phone && member.tags.length}}" class="dot-sep">·</text>
      <text wx:for="{{member.tags}}" wx:key="*this" wx:for-item="tg">
        {{tg}}<text class="dot-sep" wx:if="{{index < member.tags.length - 1}}">·</text>
      </text>
    </view>
    <view class="profile__quote serif" wx:if="{{notesParts.length}}">
      <text wx:for="{{notesParts}}" wx:key="index" class="{{item.mark ? 'med-mark' : ''}}">{{item.t}}</text>
    </view>
  </view>

  <!-- Medical alert -->
  <view class="alert" wx:if="{{medicalKeywords.length}}">
    <text class="alert__icon">○</text>
    <text class="alert__label">健康关注</text>
    <text wx:for="{{medicalKeywords}}" wx:key="*this" class="alert__kw">{{item}}</text>
  </view>

  <view class="rule"></view>

  <!-- Hero: 距上次上课天数 -->
  <view class="hero" wx:if="{{lastSession}}">
    <text class="hero__label">上一次课程</text>
    <view class="hero__display">
      <text class="hero__num serif">{{daysSinceLast}}</text>
      <text class="hero__unit serif">{{daysSinceUnit}}</text>
    </view>
    <text class="hero__sub">{{lastMeta}}</text>

    <view class="hero__stats">
      <view class="stat">
        <text class="stat__num serif">{{thisMonthCount}}</text>
        <text class="stat__lbl">本月</text>
      </view>
      <view class="stat__div"></view>
      <view class="stat">
        <text class="stat__num serif">{{totalCompleted}}</text>
        <text class="stat__lbl">累计</text>
      </view>
      <view class="stat__div"></view>
      <view class="stat">
        <text class="stat__num serif">{{attendRatePct}}<text class="stat__num-unit">%</text></text>
        <text class="stat__lbl">出勤</text>
      </view>
      <view class="stat__div" wx:if="{{showAvg}}"></view>
      <view class="stat" wx:if="{{showAvg}}">
        <text class="stat__num serif">{{avgPerMonthLabel}}</text>
        <text class="stat__lbl">月均</text>
      </view>
    </view>
  </view>

  <view class="hero hero--empty" wx:else>
    <text class="hero--empty__title serif">还没有上过课</text>
    <text class="hero--empty__hint serif">从周视图为这位会员安排第一节课</text>
  </view>

  <view class="rule" wx:if="{{recent5.length}}"></view>

  <!-- 近期记录 -->
  <view class="block" wx:if="{{recent5.length}}">
    <text class="block__title">近期记录</text>
    <view class="timeline">
      <view
        class="entry"
        wx:for="{{recent5}}"
        wx:key="id"
        wx:for-item="s"
        wx:for-index="i"
        data-id="{{s.id}}"
        bindtap="onSessionTap"
      >
        <view class="entry__rail">
          <view class="entry__dot entry__dot--{{s.status}}"></view>
          <view class="entry__line" wx:if="{{i < recent5.length - 1}}"></view>
        </view>
        <view class="entry__body">
          <view class="entry__head">
            <text class="entry__date serif">{{s.date}}</text>
            <text class="entry__time">{{s.startTime}}</text>
            <text class="entry__status entry__status--{{s.status}}">{{s.statusLabel}}</text>
          </view>
          <view class="entry__type">
            <text>{{s.courseType}}</text><text wx:if="{{s.location}}" class="entry__loc"> · {{s.location}}</text>
          </view>
          <view class="entry__focus" wx:if="{{s.focusAreas.length}}">
            <text class="entry__focus-label">重点</text>
            <text>{{s.focusJoin}}</text>
          </view>
          <view class="entry__digest" wx:if="{{s.hasContent}}">
            <text wx:for="{{s.digestParts}}" wx:key="index" wx:for-item="p" class="{{p.mark ? 'med-mark' : ''}}">{{p.t}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="rule" wx:if="{{courseTypeDistribution.length || topFocusAreas.length}}"></view>

  <!-- 训练分布 -->
  <view class="block" wx:if="{{courseTypeDistribution.length || topFocusAreas.length}}">
    <text class="block__title">训练分布</text>

    <view class="bars" wx:if="{{courseTypeDistribution.length}}">
      <view class="bar" wx:for="{{courseTypeDistribution}}" wx:key="name">
        <text class="bar__name">{{item.name}}</text>
        <view class="bar__track">
          <view class="bar__fill" style="width:{{item.pct}}%"></view>
        </view>
        <text class="bar__count serif">{{item.count}}</text>
      </view>
    </view>

    <view class="cloud" wx:if="{{topFocusAreas.length}}">
      <text class="cloud__title">常练部位</text>
      <view class="cloud__items">
        <text
          wx:for="{{topFocusAreas}}"
          wx:key="name"
          class="cloud__item serif"
          style="font-size:{{item.size}}rpx;opacity:{{item.opacity}};"
        >{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- AI 备课入口（固定底部 CTA） -->
  <view class="ai-entry" bindtap="onAiConsult">
    <text class="ai-entry__text">✦ 用 AI 备课 → 30 秒看清下次</text>
  </view>

  <view class="page__tail"></view>

  <!-- 导出明细弹窗 -->
  <view class="export-modal" wx:if="{{showExport}}" catchtouchmove="true">
    <view class="export-modal__mask" bindtap="onCloseExport"></view>
    <view class="export-modal__body" catchtap="noop">
      <view class="export-modal__header">
        <text class="export-modal__title serif">导出明细</text>
        <view class="export-modal__close" bindtap="onCloseExport">×</view>
      </view>
      <text class="export-modal__hint serif">长按选中或点底部"复制全文"</text>
      <textarea class="export-modal__text" value="{{exportText}}" disabled show-confirm-bar="{{false}}" />
      <view class="export-modal__actions">
        <view class="export-modal__btn export-modal__btn--ghost" bindtap="onCloseExport">关闭</view>
        <view class="export-modal__btn" bindtap="onCopyExport">复制全文</view>
      </view>
    </view>
  </view>
</view>
