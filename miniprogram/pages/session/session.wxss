.page {
  min-height: 100vh;
  padding: var(--spacing-md) var(--spacing-lg);
  padding-bottom: 200rpx;
}

.section {
  margin-bottom: var(--spacing-lg);
}

.section__title {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
}

.row {
  display: flex;
  gap: var(--spacing-sm);
  align-items: center;
}

.picker-btn {
  background: var(--bg-card);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  box-shadow: var(--shadow-card);
  min-width: 200rpx;
}

.duration-btn,
.mode-btn {
  flex: 1;
  text-align: center;
  padding: var(--spacing-sm);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  font-size: var(--font-sm);
  box-shadow: var(--shadow-card);
}

.duration-btn--active,
.mode-btn--active {
  background: var(--color-primary);
  color: #fff;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
}

.input {
  flex: 1;
  background: var(--bg-input);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
}

.add-btn {
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  flex-shrink: 0;
}

.textarea {
  width: 100%;
  background: var(--bg-input);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  min-height: 120rpx;
  box-sizing: border-box;
}

.member-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
}

.member-chip {
  padding: var(--spacing-xs) var(--spacing-md);
  border-radius: 100rpx;
  background: var(--bg-input);
  font-size: var(--font-sm);
}

.member-chip--active {
  background: var(--color-primary);
  color: #fff;
}

.photos {
  display: flex;
  white-space: nowrap;
  gap: var(--spacing-sm);
}

.photo-item {
  position: relative;
  display: inline-block;
}

.photo-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
}

.photo-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--color-primary-dark);
  color: #fff;
  border-radius: 50%;
  font-size: var(--font-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  display: inline-flex;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  background: var(--bg-input);
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.photo-add__icon {
  font-size: var(--font-title);
  color: var(--text-light);
}

.actions {
  margin-top: var(--spacing-xl);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.btn {
  border-radius: var(--radius-lg) !important;
  font-size: var(--font-md) !important;
  padding: var(--spacing-md) 0 !important;
}

.btn--primary {
  background: var(--color-primary) !important;
  color: #fff !important;
}

.updated-at {
  font-size: var(--font-xs);
  color: var(--text-light);
  text-align: center;
  display: block;
}

.btn--danger {
  background: transparent !important;
  color: var(--color-primary-dark) !important;
  border: 2rpx solid var(--color-primary-dark) !important;
}

/* Summary CTA */
.card--summary {
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-card);
}
.summary-cta__preview {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  line-height: 1.5;
  display: block;
  margin-bottom: var(--spacing-sm);
}
.summary-cta__action {
  font-size: var(--font-body);
  color: var(--color-primary);
  font-weight: 600;
}
