.page {
  min-height: 100vh;
  background: var(--paper);
  padding: 28rpx 56rpx;
  padding-bottom: 200rpx;
}

/* === Section === */
.section {
  margin-bottom: 36rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--rule-soft);
}
.section:last-child { border-bottom: none; }

.section__title {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 500;
  margin-bottom: 18rpx;
}

.row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

/* === Picker buttons === */
.picker-btn {
  background: transparent;
  padding: 14rpx 0;
  font-family: var(--display);
  font-size: 30rpx;
  color: var(--ink);
  border-bottom: 1rpx solid var(--rule);
  letter-spacing: 0.01em;
  flex: 1;
  min-height: 64rpx;
  display: flex;
  align-items: center;
}

/* === Chip-style toggle (duration / mode) === */
.duration-btn,
.mode-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: transparent;
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink-3);
  letter-spacing: 0.04em;
}

.duration-btn--active,
.mode-btn--active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

/* === Inputs === */
.input {
  flex: 1;
  background: transparent;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: var(--ink);
  border-bottom: 1rpx solid var(--rule);
  letter-spacing: 0.01em;
}

.add-btn {
  padding: 12rpx 24rpx;
  background: transparent;
  color: var(--ink-2);
  border: 1rpx solid var(--ink-3);
  border-radius: 999rpx;
  font-size: 24rpx;
  letter-spacing: 0.06em;
  flex-shrink: 0;
}
.add-btn:active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

.textarea {
  width: 100%;
  background: transparent;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  min-height: 120rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--rule);
}

/* === Member chips === */
.member-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.member-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 1rpx solid var(--rule);
  font-size: 26rpx;
  color: var(--ink-2);
  letter-spacing: 0.01em;
}
.member-chip--active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

/* === Photos === */
.photos {
  display: flex;
  white-space: nowrap;
  gap: 16rpx;
}
.photo-item {
  position: relative;
  display: inline-block;
}
.photo-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--rule);
}
.photo-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--ink);
  color: var(--paper);
  border-radius: 50%;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add {
  display: inline-flex;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: transparent;
  border: 1rpx dashed var(--rule);
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.photo-add__icon {
  font-size: 44rpx;
  color: var(--ink-4);
  font-weight: 300;
}

/* === Actions === */
.actions {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  border-radius: 999rpx !important;
  font-size: 28rpx !important;
  padding: 22rpx 0 !important;
  letter-spacing: 0.06em;
}

.btn--primary {
  background: var(--ink) !important;
  color: var(--paper) !important;
}

.btn--danger {
  background: transparent !important;
  color: var(--warm) !important;
  border: 1rpx solid var(--warm) !important;
}

.updated-at {
  font-size: 22rpx;
  color: var(--ink-4);
  text-align: center;
  display: block;
  font-style: italic;
  font-family: var(--display);
}

/* === Summary CTA === */
.card--summary {
  background: rgba(74, 124, 89, 0.05);
  border: 1rpx solid rgba(74, 124, 89, 0.18);
  border-radius: 16rpx;
  padding: 24rpx;
}
.summary-cta__preview {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}
.summary-cta__action {
  font-family: var(--display);
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* === AI 课程档案 === */
.seg-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 18rpx;
  border-top: 1rpx solid var(--rule-soft);
}
.seg-toggle__arrow { font-size: 18rpx; }

.seg-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.seg-item {
  background: rgba(74, 124, 89, 0.04);
  border: 1rpx solid var(--rule-soft);
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
}
.seg-item__head {
  display: block;
  font-size: 20rpx;
  color: var(--color-primary);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 10rpx;
  font-weight: 500;
}
.seg-item__text {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
  display: block;
  word-break: break-all;
}

/* === 课后快速记录 === */
.qn-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(31, 29, 26, 0.4); z-index: 999;
}
.qn-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 44rpx 44rpx calc(env(safe-area-inset-bottom) + 32rpx);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.qn-title {
  font-family: var(--display);
  font-size: 36rpx;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.qn-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.qn-chip {
  font-size: 25rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: transparent;
  color: var(--ink-2);
  border: 1rpx solid var(--rule);
}
.qn-chip--active {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--paper);
}
.qn-input {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--rule);
  font-size: 28rpx;
  color: var(--ink);
}
.qn-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 8rpx;
}
.qn-btn {
  font-size: 26rpx;
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  border: none;
  letter-spacing: 0.06em;
}
.qn-btn--plain {
  background: transparent;
  color: var(--ink);
  border: 1rpx solid var(--ink-2);
}
.qn-btn--primary {
  background: var(--ink);
  color: var(--paper);
}

/* === Status chips（覆盖原有） === */
.chip--status-scheduled.chip--active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.chip--status-completed.chip--active { background: var(--color-primary); color: var(--paper); border-color: var(--color-primary); }
.chip--status-cancelled.chip--active { background: var(--ink-3); color: var(--paper); border-color: var(--ink-3); }
.chip--status-noshow.chip--active { background: var(--warm); color: var(--paper); border-color: var(--warm); }
