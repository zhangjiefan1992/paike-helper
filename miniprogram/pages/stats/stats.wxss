.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 维度切换 */
.view-toggle {
  display: flex;
  justify-content: flex-end;
  padding: var(--spacing-sm) var(--spacing-lg) 0;
}

.view-toggle__btn {
  font-size: var(--font-xs);
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  background: var(--bg-card);
  color: var(--color-primary);
  box-shadow: var(--shadow-card);
}

/* 周切换导航 */
.week-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
  padding: var(--spacing-md) var(--spacing-lg);
}

.week-nav__arrow {
  font-size: var(--font-xl);
  color: var(--color-primary);
  padding: var(--spacing-sm);
}

.week-nav__label {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.section {
  margin: var(--spacing-md);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-lg);
}

.section__header {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.section__title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}

.section__sub {
  font-size: var(--font-xs);
  color: var(--text-light);
}

/* 汇总网格 */
.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.summary-card {
  text-align: center;
  padding: var(--spacing-sm) 0;
}

.summary-card--primary {
  grid-column: 1 / -1;
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
}

.summary-card__value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.summary-card--primary .summary-card__value {
  font-size: 64rpx;
}

.summary-card__value--green {
  color: var(--color-completed);
}

.summary-card__value--grey {
  color: var(--color-cancelled);
}

.summary-card__value--orange {
  color: var(--color-noshow);
}

.summary-card__label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.summary-card__diff {
  font-size: var(--font-xs);
  color: var(--text-light);
  margin-top: 4rpx;
}

.diff--up {
  color: var(--color-completed);
}

.diff--down {
  color: var(--color-cancelled);
}

/* 详情行 */
.detail-row {
  display: flex;
  justify-content: space-around;
  padding: var(--spacing-sm) 0;
  border-top: 2rpx solid var(--bg-input, #E8E4DF);
}

.detail-item {
  text-align: center;
}

.detail-item__label {
  font-size: var(--font-xs);
  color: var(--text-light);
  display: block;
}

.detail-item__value {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-top: 4rpx;
}

/* 会员排行 */
.member-rank {
  margin-bottom: var(--spacing-sm);
}

.rank-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) 0;
  border-bottom: 2rpx solid var(--bg-input, #E8E4DF);
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 40rpx;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-primary);
  text-align: center;
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}

.rank-sub {
  font-size: var(--font-xs);
  color: var(--text-light);
}

.rank-count {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
  flex-shrink: 0;
}

.rank-unit {
  font-size: var(--font-xs);
  font-weight: 400;
  color: var(--text-secondary);
}

.empty-hint {
  text-align: center;
  padding: var(--spacing-lg) 0;
  color: var(--text-light);
  font-size: var(--font-sm);
}

/* 流失预警 */
.inactive-section {
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-md);
  border-top: 2rpx solid var(--bg-input, #E8E4DF);
}

.inactive-title {
  font-size: var(--font-sm);
  color: var(--color-noshow);
  font-weight: 500;
  margin-bottom: var(--spacing-sm);
}

.inactive-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.inactive-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-xs) 0;
}

.inactive-name {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
}

.inactive-days {
  font-size: var(--font-xs);
  color: var(--color-noshow);
  flex-shrink: 0;
}

/* 条形图 */
.bar-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.bar-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.bar-label {
  width: 140rpx;
  font-size: var(--font-sm);
  color: var(--text-primary);
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-track {
  flex: 1;
  height: 28rpx;
  background: var(--bg-input, #E8E4DF);
  border-radius: 14rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 14rpx;
  min-width: 8rpx;
  transition: width 0.3s ease;
}

.bar-fill--alt {
  background: var(--color-secondary, #7E9F7A);
}

.bar-count {
  width: 50rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  text-align: right;
  flex-shrink: 0;
}
