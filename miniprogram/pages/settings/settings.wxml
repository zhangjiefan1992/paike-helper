<view class="page">
  <!-- 预设管理 -->
  <view class="section">
    <view class="section__title">预设管理</view>

    <!-- 课程类型 -->
    <view class="preset-group">
      <view class="preset-label">课程类型</view>
      <view class="preset-list">
        <view class="preset-item" wx:for="{{config.courseTypes}}" wx:key="*this">
          <text class="preset-item__text">{{item}}</text>
          <view class="preset-item__del" bindtap="onDeleteCourseType" data-index="{{index}}">×</view>
        </view>
      </view>
      <view class="preset-add">
        <input class="preset-input" placeholder="添加课程类型" value="{{courseTypeInput}}" bindinput="onCourseTypeInput" bindconfirm="onAddCourseType" />
        <view class="preset-add-btn" bindtap="onAddCourseType">添加</view>
      </view>
    </view>

    <!-- 地点 -->
    <view class="preset-group">
      <view class="preset-label">地点</view>
      <view class="preset-list">
        <view class="preset-item" wx:for="{{config.locations}}" wx:key="*this">
          <text class="preset-item__text">{{item}}</text>
          <view class="preset-item__del" bindtap="onDeleteLocation" data-index="{{index}}">×</view>
        </view>
        <view class="preset-empty" wx:if="{{config.locations.length === 0}}">暂无预设地点</view>
      </view>
      <view class="preset-add">
        <input class="preset-input" placeholder="添加地点" value="{{locationInput}}" bindinput="onLocationInput" bindconfirm="onAddLocation" />
        <view class="preset-add-btn" bindtap="onAddLocation">添加</view>
      </view>
    </view>

    <!-- 训练重点 -->
    <view class="preset-group">
      <view class="preset-label">训练重点</view>
      <view class="preset-list">
        <view class="preset-item" wx:for="{{config.focusAreaOptions}}" wx:key="*this">
          <text class="preset-item__text">{{item}}</text>
          <view class="preset-item__del" bindtap="onDeleteFocusArea" data-index="{{index}}">×</view>
        </view>
      </view>
      <view class="preset-add">
        <input class="preset-input" placeholder="添加训练重点" value="{{focusAreaInput}}" bindinput="onFocusAreaInput" bindconfirm="onAddFocusArea" />
        <view class="preset-add-btn" bindtap="onAddFocusArea">添加</view>
      </view>
    </view>

    <!-- 默认时长 -->
    <view class="preset-group">
      <view class="preset-label">默认课程时长</view>
      <picker mode="selector" range="{{durationOptions}}" value="{{0}}" bindchange="onDurationChange">
        <view class="picker-row">
          <text>{{config.defaultDuration}} 分钟</text>
          <text class="picker-arrow">▸</text>
        </view>
      </picker>
    </view>

    <!-- 可排课时间 -->
    <view class="preset-group">
      <view class="preset-label">可排课时间段</view>
      <view class="time-range">
        <picker mode="time" value="{{config.workingHours.start}}" bindchange="onStartTimeChange">
          <view class="time-pick">{{config.workingHours.start}}</view>
        </picker>
        <text class="time-sep">至</text>
        <picker mode="time" value="{{config.workingHours.end}}" bindchange="onEndTimeChange">
          <view class="time-pick">{{config.workingHours.end}}</view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 外观 -->
  <view class="section">
    <view class="section__title">外观</view>
    <view class="preset-group">
      <view class="preset-label">周视图主题</view>
      <view class="theme-picker">
        <view
          wx:for="{{themeOptions}}"
          wx:key="value"
          class="theme-option {{currentTheme === item.value ? 'theme-option--active' : ''}}"
          bindtap="onThemeSelect"
          data-value="{{item.value}}"
        >
          <view class="theme-option__preview" style="background: {{item.preview}}"></view>
          <text class="theme-option__name">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section">
    <view class="section__title">数据管理</view>
    <view class="action-row" bindtap="onExport">
      <text class="action-text">导出数据</text>
      <text class="action-hint">备份到微信聊天</text>
      <text class="action-arrow">▸</text>
    </view>
    <view class="action-row" bindtap="onImport">
      <text class="action-text">导入数据</text>
      <text class="action-hint">从聊天文件恢复</text>
      <text class="action-arrow">▸</text>
    </view>
  </view>

  <!-- 文本导入导出 -->
  <view class="section">
    <view class="section__title">课程文本导入导出</view>
    <view class="text-format-hint">
      <text class="text-format-hint__text">格式：3.23 私教 10:30 周一 周文娟 旺君馆</text>
    </view>
    <view class="action-row" bindtap="onTextExport">
      <text class="action-text">导出为文本</text>
      <text class="action-hint">复制课程列表</text>
      <text class="action-arrow">▸</text>
    </view>
    <view class="action-row" bindtap="onTextImport">
      <text class="action-text">从文本导入</text>
      <text class="action-hint">粘贴课程列表</text>
      <text class="action-arrow">▸</text>
    </view>
  </view>

  <!-- 文本弹窗 -->
  <view class="text-modal" wx:if="{{showTextModal}}" catchtouchmove="true">
    <view class="text-modal__mask" bindtap="onTextModalClose"></view>
    <view class="text-modal__body">
      <view class="text-modal__header">
        <text class="text-modal__title">{{textModalMode === 'export' ? '课程文本' : '粘贴课程文本'}}</text>
        <view class="text-modal__close" bindtap="onTextModalClose">×</view>
      </view>
      <block wx:if="{{textModalMode === 'export'}}">
        <view class="text-modal__content">
          <text class="text-modal__text" user-select="{{true}}">{{textExportContent}}</text>
        </view>
        <view class="text-modal__actions">
          <view class="text-modal__btn text-modal__btn--primary" bindtap="onTextModalCopy">复制全部</view>
        </view>
      </block>
      <block wx:else>
        <view class="text-modal__content">
          <textarea
            class="text-modal__textarea"
            placeholder="每行一节课，格式如：&#10;3.23 私教 10:30 周一 周文娟 旺君馆"
            value="{{textImportContent}}"
            bindinput="onTextModalInput"
            maxlength="-1"
          />
        </view>
        <view class="text-modal__actions">
          <view class="text-modal__btn" bindtap="onTextModalClose">取消</view>
          <view class="text-modal__btn text-modal__btn--primary" bindtap="onTextModalConfirmImport">导入</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 统计 -->
  <view class="section">
    <view class="section__title">统计</view>
    <view class="action-row" bindtap="onGoStats">
      <text class="action-text">课程统计</text>
      <text class="action-hint">按月/按类型/按会员</text>
      <text class="action-arrow">▸</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section__title">关于</view>
    <view class="about">
      <text class="about__name">排课助手</text>
      <text class="about__version">v1.0.0</text>
    </view>
  </view>
</view>
