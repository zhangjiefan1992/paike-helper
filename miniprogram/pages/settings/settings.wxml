<view class="page theme-{{currentTheme}}">
  <view class="hdr">
    <text class="hdr__title serif">设置</text>
    <text class="hdr__sub serif">预设、外观与数据</text>
  </view>

  <view class="rule"></view>

  <!-- 预设：课程类型 -->
  <view class="block">
    <view class="block__head">
      <text class="block__label">课程类型</text>
      <text class="block__count" wx:if="{{config.courseTypes.length}}">{{config.courseTypes.length}}</text>
    </view>
    <view class="chips" wx:if="{{config.courseTypes.length}}">
      <view class="chip" wx:for="{{config.courseTypes}}" wx:key="*this">
        <text>{{item}}</text>
        <view class="chip__x" data-index="{{index}}" bindtap="onDeleteCourseType">×</view>
      </view>
    </view>
    <text class="empty-line serif" wx:else>未添加</text>
    <view class="add">
      <input
        class="add__input"
        placeholder="新增课程类型"
        value="{{courseTypeInput}}"
        bindinput="onCourseTypeInput"
        bindconfirm="onAddCourseType"
      />
      <view class="add__btn" bindtap="onAddCourseType">添加</view>
    </view>
  </view>

  <view class="rule"></view>

  <!-- 预设：常用地点 -->
  <view class="block">
    <view class="block__head">
      <text class="block__label">常用地点</text>
      <text class="block__count" wx:if="{{config.locations.length}}">{{config.locations.length}}</text>
    </view>
    <view class="chips" wx:if="{{config.locations.length}}">
      <view class="chip" wx:for="{{config.locations}}" wx:key="*this">
        <text>{{item}}</text>
        <view class="chip__x" data-index="{{index}}" bindtap="onDeleteLocation">×</view>
      </view>
    </view>
    <text class="empty-line serif" wx:else>未添加</text>
    <view class="add">
      <input
        class="add__input"
        placeholder="新增地点"
        value="{{locationInput}}"
        bindinput="onLocationInput"
        bindconfirm="onAddLocation"
      />
      <view class="add__btn" bindtap="onAddLocation">添加</view>
    </view>
  </view>

  <view class="rule"></view>

  <!-- 预设：训练重点 -->
  <view class="block">
    <view class="block__head">
      <text class="block__label">训练重点</text>
      <text class="block__count" wx:if="{{config.focusAreaOptions.length}}">{{config.focusAreaOptions.length}}</text>
    </view>
    <view class="chips" wx:if="{{config.focusAreaOptions.length}}">
      <view class="chip" wx:for="{{config.focusAreaOptions}}" wx:key="*this">
        <text>{{item}}</text>
        <view class="chip__x" data-index="{{index}}" bindtap="onDeleteFocusArea">×</view>
      </view>
    </view>
    <text class="empty-line serif" wx:else>未添加</text>
    <view class="add">
      <input
        class="add__input"
        placeholder="新增训练重点"
        value="{{focusAreaInput}}"
        bindinput="onFocusAreaInput"
        bindconfirm="onAddFocusArea"
      />
      <view class="add__btn" bindtap="onAddFocusArea">添加</view>
    </view>
  </view>

  <view class="rule"></view>

  <!-- 默认 -->
  <view class="block">
    <view class="block__head"><text class="block__label">默认</text></view>
    <view class="rows">
      <picker mode="selector" range="{{durationOptions}}" bindchange="onDurationChange">
        <view class="row">
          <text class="row__label">课程时长</text>
          <text class="row__val serif">{{config.defaultDuration}} 分钟</text>
          <text class="row__chev">›</text>
        </view>
      </picker>
      <picker mode="time" value="{{config.workingHours.start}}" bindchange="onStartTimeChange">
        <view class="row">
          <text class="row__label">工作开始</text>
          <text class="row__val serif">{{config.workingHours.start}}</text>
          <text class="row__chev">›</text>
        </view>
      </picker>
      <picker mode="time" value="{{config.workingHours.end}}" bindchange="onEndTimeChange">
        <view class="row">
          <text class="row__label">工作结束</text>
          <text class="row__val serif">{{config.workingHours.end}}</text>
          <text class="row__chev">›</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="rule"></view>

  <!-- 周视图主题 -->
  <view class="block">
    <view class="block__head"><text class="block__label">周视图主题</text></view>
    <view class="themes">
      <view
        wx:for="{{themeOptions}}"
        wx:key="value"
        class="theme {{currentTheme === item.value ? 'theme--active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onThemeSelect"
      >
        <view class="theme__preview" style="background: {{item.preview}}"></view>
        <text class="theme__name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="rule"></view>

  <!-- 课表密度 -->
  <view class="block">
    <view class="block__head"><text class="block__label">课表密度</text></view>
    <view class="density-options">
      <view
        wx:for="{{densityOptions}}"
        wx:key="value"
        class="density {{currentDensity === item.value ? 'density--active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onDensitySelect"
      >
        <view class="density__radio {{currentDensity === item.value ? 'density__radio--on' : ''}}"></view>
        <view class="density__text">
          <text class="density__name">{{item.name}}</text>
          <text class="density__desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="rule"></view>

  <!-- 工具 -->
  <view class="block">
    <view class="block__head"><text class="block__label">工具</text></view>
    <view class="rows">
      <view class="row" bindtap="onGoStats">
        <text class="row__label">课程统计</text>
        <text class="row__val row__val--muted serif">查看数据</text>
        <text class="row__chev">›</text>
      </view>
    </view>
  </view>

  <view class="rule"></view>

  <!-- 云端备份 -->
  <view class="block">
    <view class="block__head">
      <text class="block__label">云端备份</text>
      <text class="block__count" wx:if="{{backupHasCloud}}">已就绪</text>
    </view>
    <view class="rows">
      <view class="row">
        <text class="row__label">上次备份</text>
        <text class="row__val serif">{{backupTimeLabel}}</text>
      </view>
      <view class="row" bindtap="onBackupNow">
        <text class="row__label">立即备份</text>
        <text class="row__val row__val--muted serif">{{backingUp ? '备份中...' : '上传到云存储'}}</text>
        <text class="row__chev">›</text>
      </view>
      <view class="row {{!backupHasCloud ? 'row--disabled' : ''}}" bindtap="onRestore">
        <text class="row__label">从云端恢复</text>
        <text class="row__val row__val--muted serif">{{backupHasCloud ? '覆盖本地' : '无可用备份'}}</text>
        <text class="row__chev">›</text>
      </view>
    </view>
    <text class="block__note serif">每次切后台或退出小程序时自动备份；切换设备或重装请用上方"恢复"</text>
  </view>

  <view class="rule"></view>

  <!-- 数据 -->
  <view class="block">
    <view class="block__head"><text class="block__label">数据</text></view>
    <view class="rows">
      <view class="row" bindtap="onExport">
        <text class="row__label">导出数据</text>
        <text class="row__val row__val--muted">备份到聊天</text>
        <text class="row__chev">›</text>
      </view>
      <view class="row" bindtap="onImport">
        <text class="row__label">导入数据</text>
        <text class="row__val row__val--muted">从聊天文件</text>
        <text class="row__chev">›</text>
      </view>
      <view class="row" bindtap="onTextExport">
        <text class="row__label">导出 · 文本课表</text>
        <text class="row__chev">›</text>
      </view>
      <view class="row" bindtap="onTextImport">
        <text class="row__label">导入 · 文本课表</text>
        <text class="row__chev">›</text>
      </view>
    </view>
  </view>

  <!-- 意见反馈 -->
  <view class="rule"></view>
  <view class="block">
    <view class="block__head">
      <text class="block__label">意见反馈</text>
    </view>
    <textarea
      class="feedback__input"
      placeholder="使用中遇到问题或有建议，欢迎告诉我们 ☺"
      placeholder-class="feedback__placeholder"
      value="{{feedbackText}}"
      bindinput="onFeedbackInput"
      maxlength="500"
      auto-height
    />
    <view class="feedback__footer">
      <text class="feedback__count">{{feedbackText.length || 0}}/500</text>
      <view class="feedback__btn {{feedbackText && !feedbackSubmitting ? '' : 'feedback__btn--disabled'}}" bindtap="onSubmitFeedback">{{feedbackSubmitting ? '提交中...' : '提交'}}</view>
    </view>
  </view>

  <view class="foot">
    <text class="foot__brand serif">排课助手</text>
    <text class="foot__ver">v1.0.0 · keleya.org</text>
  </view>

  <view class="page__tail"></view>

  <!-- 文本弹窗（保留原逻辑，仅样式编辑式化） -->
  <view class="text-modal" wx:if="{{showTextModal}}" catchtouchmove="true">
    <view class="text-modal__mask" bindtap="onTextModalClose"></view>
    <view class="text-modal__body">
      <view class="text-modal__header">
        <text class="text-modal__title serif">{{textModalMode === 'export' ? '课程文本' : '粘贴课表'}}</text>
        <view class="text-modal__close" bindtap="onTextModalClose">×</view>
      </view>
      <block wx:if="{{textModalMode === 'export'}}">
        <view class="text-modal__content">
          <text class="text-modal__text" user-select="{{true}}">{{textExportContent}}</text>
        </view>
        <view class="text-modal__actions">
          <view class="text-modal__btn text-modal__btn--primary" bindtap="onTextModalCopy">复制全部</view>
        </view>
      </block>
      <block wx:else>
        <view class="text-modal__content">
          <textarea
            class="text-modal__textarea"
            placeholder="每行一节课，例：3.23 私教 10:30 周一 周文娟 旺君馆"
            value="{{textImportContent}}"
            bindinput="onTextModalInput"
            maxlength="-1"
          />
        </view>
        <view class="text-modal__actions">
          <view class="text-modal__btn" bindtap="onTextModalClose">取消</view>
          <view class="text-modal__btn text-modal__btn--primary" bindtap="onTextModalConfirmImport">导入</view>
        </view>
      </block>
    </view>
  </view>
</view>
