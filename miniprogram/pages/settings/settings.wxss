.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: env(safe-area-inset-bottom);
}

/* === Header === */
.hdr {
  padding: 52rpx 56rpx 44rpx;
}
.hdr__title {
  display: block;
  font-size: 76rpx;
  font-weight: 400;
  line-height: 1;
  color: var(--ink);
  letter-spacing: -0.02em;
  margin-bottom: 12rpx;
}
.hdr__sub {
  font-style: italic;
  font-weight: 300;
  font-size: 26rpx;
  color: var(--ink-3);
}

.rule {
  height: 1rpx;
  background: var(--rule);
  margin: 0 56rpx;
}

/* === Block === */
.block { padding: 44rpx 56rpx; }
.block__head {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.block__label {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 500;
}
.block__count {
  font-family: var(--display);
  font-weight: 300;
  font-size: 22rpx;
  color: var(--ink-4);
}

/* === Chips === */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 20rpx 10rpx 24rpx;
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  background: transparent;
  font-size: 25rpx;
  color: var(--ink-2);
  letter-spacing: 0.01em;
}
.chip__x {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  color: var(--ink-4);
  font-size: 24rpx;
  line-height: 1;
}

.empty-line {
  display: block;
  font-style: italic;
  font-size: 24rpx;
  color: var(--ink-4);
  margin-bottom: 28rpx;
}

/* === Add input === */
.add {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--rule);
}
.add__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.add__btn {
  font-size: 26rpx;
  color: var(--ink-2);
  letter-spacing: 0.06em;
  padding: 8rpx 4rpx;
}

/* === Themes === */
.themes {
  display: flex;
  gap: 28rpx;
  flex-wrap: wrap;
}
.theme {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border: 1rpx solid transparent;
  border-radius: 20rpx;
}
.theme--active { border-color: var(--ink); }
.theme__preview {
  display: block;
  width: 112rpx;
  height: 76rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--rule);
}
.theme__name {
  font-size: 23rpx;
  color: var(--ink-3);
  letter-spacing: 0.04em;
}
.theme--active .theme__name { color: var(--ink); }

/* === Rows === */
.rows {
  display: flex;
  flex-direction: column;
}
.row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--rule-soft);
}
.row:last-child { border-bottom: none; }
.row__label {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.row__val {
  font-size: 27rpx;
  color: var(--ink-2);
  letter-spacing: 0.01em;
}
.row__val--muted {
  color: var(--ink-4);
  font-style: italic;
}
.row__chev {
  font-family: var(--display);
  font-size: 32rpx;
  color: var(--ink-4);
}

/* === Footer === */
.foot {
  padding: 72rpx 56rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.foot__brand {
  font-size: 28rpx;
  color: var(--ink-3);
  letter-spacing: 0.04em;
}
.foot__ver {
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: 0.06em;
}

.page__tail { height: 48rpx; }

/* === Text modal === */
.text-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
}
.text-modal__mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(31, 29, 26, 0.4);
}
.text-modal__body {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 44rpx 44rpx calc(env(safe-area-inset-bottom) + 44rpx);
  max-height: 86vh;
  display: flex;
  flex-direction: column;
}
.text-modal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.text-modal__title {
  font-size: 42rpx;
  color: var(--ink);
  font-weight: 400;
  letter-spacing: -0.01em;
}
.text-modal__close {
  width: 64rpx; height: 64rpx;
  display: flex;
  align-items: center; justify-content: center;
  font-size: 44rpx;
  color: var(--ink-3);
}
.text-modal__content {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 28rpx;
  padding: 24rpx 28rpx;
  background: var(--rule-soft);
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  max-height: 60vh;
}
.text-modal__text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
}
.text-modal__textarea {
  width: 100%;
  min-height: 320rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
}
.text-modal__actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.text-modal__btn {
  padding: 20rpx 44rpx;
  font-size: 27rpx;
  color: var(--ink);
  border: 1rpx solid var(--ink-2);
  border-radius: 999rpx;
  letter-spacing: 0.06em;
}
.text-modal__btn--primary {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}
