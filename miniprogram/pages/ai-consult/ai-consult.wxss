.page {
  min-height: 100vh;
  background: var(--paper);
  padding: 40rpx 48rpx 80rpx;
}

/* Brief */
.brief {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.brief__name {
  font-size: 44rpx;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.brief__meta {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* Input area */
.input-area {
  margin-bottom: 40rpx;
}
.input-area__textarea {
  width: 100%;
  min-height: 140rpx;
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
  background: var(--paper);
  box-sizing: border-box;
}
.input-area__btn {
  margin-top: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  background: var(--ink);
  color: var(--paper);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
}
.input-area__btn--disabled {
  opacity: 0.45;
}

/* Loading */
.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
}
.loading-area__dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.loading-area__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ink-3);
  animation: pulse 1.2s ease-in-out infinite;
}
.loading-area__dot:nth-child(2) { animation-delay: 0.2s; }
.loading-area__dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes pulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1.2); }
}
.loading-area__hint {
  font-size: 24rpx;
  color: var(--ink-3);
  font-style: italic;
}

/* Results */
.results {
  margin-top: 16rpx;
}

/* Section */
.section {
  margin-bottom: 48rpx;
}
.section__title {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 24rpx;
  font-weight: 500;
}
.section__body {
  background: var(--rule-soft);
  border-radius: 16rpx;
  padding: 28rpx;
}
.section__text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink);
  white-space: pre-wrap;
}

/* School cards */
.school {
  border: 1rpx solid var(--rule);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.school--open {
  border-color: var(--ink-4);
}
.school__header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}
.school__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.school__name {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}
.school__arrow {
  font-size: 22rpx;
  color: var(--ink-4);
}
.school__body {
  padding: 0 28rpx 24rpx;
  border-top: 1rpx solid var(--rule-soft);
}
.school__text {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink-2);
  white-space: pre-wrap;
}

/* Actions */
.actions {
  margin: 48rpx 0 40rpx;
}
.actions__btn {
  padding: 24rpx 0;
  text-align: center;
  background: var(--primary, #4A7C59);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
}
.actions__btn:active {
  opacity: 0.85;
}

/* Followup */
.followup {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--rule);
}
.followup__history {
  margin-bottom: 24rpx;
}
.followup__item {
  margin-bottom: 24rpx;
}
.followup__q {
  display: block;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 8rpx;
}
.followup__a {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
  white-space: pre-wrap;
}
.followup__input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.followup__field {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.followup__send {
  padding: 16rpx 28rpx;
  background: var(--ink);
  color: var(--paper);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.followup__send--disabled {
  opacity: 0.45;
}

/* Disclaimer */
.disclaimer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-4);
  font-style: italic;
}
