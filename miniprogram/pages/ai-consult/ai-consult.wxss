.page {
  min-height: 100vh;
  background: var(--paper);
  padding: calc(env(safe-area-inset-top) + 20rpx) 48rpx 120rpx;
}

/* Nav bar */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  margin-bottom: 16rpx;
}
.nav-bar__title {
  font-size: 36rpx;
  color: var(--ink);
  font-weight: 400;
  letter-spacing: -0.01em;
}
.nav-bar__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ink-3);
}

/* Context section */
.context {
  margin-bottom: 40rpx;
  padding: 28rpx;
  background: var(--rule-soft);
  border-radius: 16rpx;
}
.context__label {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.08em;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.context__list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.context__item {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* Question section */
.question-section {
  margin-bottom: 28rpx;
}
.question-section__label {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 16rpx;
}
.question-section__textarea {
  width: 100%;
  min-height: 120rpx;
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
  background: var(--paper);
  box-sizing: border-box;
}

/* Quick tags */
.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 48rpx;
}
.quick-tags__item {
  padding: 14rpx 28rpx;
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: var(--paper);
}
.quick-tags__item:active {
  background: var(--rule-soft);
  border-color: var(--ink-4);
}

/* Start button */
.start-btn {
  padding: 28rpx 0;
  text-align: center;
  background: var(--ink);
  color: var(--paper);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
}
.start-btn:active {
  opacity: 0.85;
}

/* Loading phase */
.phase-loading {
  padding-top: 16rpx;
}

.user-question {
  margin-bottom: 32rpx;
}
.user-question__label {
  font-size: 24rpx;
  color: var(--ink-3);
}
.user-question__text {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.school-status {
  margin-bottom: 20rpx;
}
.school-status__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--rule-soft);
}
.school-status__icon {
  font-size: 24rpx;
  color: var(--ink-3);
}
.school-status__name {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}
.school-status__state {
  font-size: 24rpx;
  color: var(--ink-4);
  font-style: italic;
}

.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}
.loading-area__dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.loading-area__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ink-3);
  animation: pulse 1.2s ease-in-out infinite;
}
.loading-area__dot:nth-child(2) { animation-delay: 0.2s; }
.loading-area__dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes pulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1.2); }
}
.loading-area__hint {
  font-size: 24rpx;
  color: var(--ink-3);
  font-style: italic;
}

/* Result phase */
.phase-result {
  padding-top: 16rpx;
}

/* School fold */
.school-fold {
  margin-bottom: 32rpx;
}
.school-fold__item {
  border-bottom: 1rpx solid var(--rule-soft);
}
.school-fold__item--open {
  border-bottom-color: var(--rule);
}
.school-fold__header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
}
.school-fold__check {
  font-size: 24rpx;
  color: #5B8C5A;
  font-weight: 600;
}
.school-fold__fail {
  font-size: 24rpx;
  color: #C75050;
  font-weight: 600;
}
.school-fold__name {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}
.school-fold__arrow {
  font-size: 22rpx;
  color: var(--ink-4);
}
.school-fold__body {
  padding: 0 0 24rpx 36rpx;
}
.school-fold__text {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink-2);
  white-space: pre-wrap;
}

/* Synthesis */
.synthesis {
  margin-bottom: 40rpx;
}
.synthesis__divider {
  height: 2rpx;
  background: var(--ink-4);
  margin: 8rpx 0;
}
.synthesis__title {
  display: block;
  font-size: 36rpx;
  color: var(--ink);
  text-align: center;
  padding: 20rpx 0;
  letter-spacing: 0.04em;
}
.synthesis__body {
  margin-top: 16rpx;
  padding: 28rpx;
  background: var(--rule-soft);
  border-radius: 16rpx;
}
.synthesis__text {
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--ink);
  white-space: pre-wrap;
}

/* Disclaimer */
.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-4);
  margin-bottom: 40rpx;
}

/* Actions */
.actions {
  margin-bottom: 40rpx;
}
.actions__row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.actions__primary {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  background: var(--ink);
  color: var(--paper);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.actions__primary:active {
  opacity: 0.85;
}
.actions__secondary {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  border: 1rpx solid var(--ink);
  color: var(--ink);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.actions__secondary:active {
  background: var(--rule-soft);
}
.actions__link {
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-3);
  text-decoration: underline;
}

/* Followup */
.phase-followup {
  padding-top: 32rpx;
  border-top: 1rpx solid var(--rule);
  margin-top: 16rpx;
}
.followup__history {
  margin-bottom: 28rpx;
}
.followup__item {
  margin-bottom: 24rpx;
}
.followup__q {
  display: block;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 8rpx;
}
.followup__a {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
  white-space: pre-wrap;
}
.followup__input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.followup__field {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.followup__send {
  padding: 16rpx 28rpx;
  background: var(--ink);
  color: var(--paper);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.followup__send--disabled {
  opacity: 0.45;
}
