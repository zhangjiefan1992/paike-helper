<view class="page">
  <!-- 顶部标题栏 -->
  <view class="nav-bar">
    <text class="nav-bar__title serif">AI 备课 · {{member.name}}</text>
    <view class="nav-bar__close" bindtap="onClose">×</view>
  </view>

  <!-- 阶段一：输入区（未开始咨询时） -->
  <view class="phase-input" wx:if="{{!loading && !done}}">
    <!-- 会员上下文（自动注入） -->
    <view class="context" wx:if="{{member}}">
      <text class="context__label">会员上下文</text>
      <view class="context__list">
        <text class="context__item" wx:if="{{sessionCount}}">· {{sessionCount}} 节累计{{lastSessionDesc ? '，最近 ' + lastSessionDesc : ''}}</text>
        <text class="context__item" wx:if="{{monthCount}}">· 本月 {{monthCount}} 节{{attendance ? '，出勤 ' + attendance : ''}}</text>
        <text class="context__item" wx:if="{{memberTags}}">· 标签：{{memberTags}}</text>
        <text class="context__item" wx:if="{{recentFocus}}">· 最近重点：{{recentFocus}}</text>
        <text class="context__item" wx:if="{{memberNotes}}">· 注意：{{memberNotes}}</text>
      </view>
    </view>

    <!-- 教练提问 -->
    <view class="question-section">
      <text class="question-section__label">你想问什么？</text>
      <textarea
        class="question-section__textarea"
        value="{{question}}"
        bindinput="onQuestionInput"
        placeholder="例：下次重点 / 强度该不该升"
        maxlength="300"
      />
    </view>

    <!-- 快速选项 -->
    <view class="quick-tags">
      <view
        class="quick-tags__item"
        wx:for="{{quickOptions}}"
        wx:key="index"
        bindtap="onQuickOption"
        data-text="{{item}}"
      >{{item}}</view>
    </view>

    <!-- 开始咨询按钮 -->
    <view class="start-btn" bindtap="onStartConsult">
      <text>开始咨询 ✦</text>
    </view>
  </view>

  <!-- 阶段二：加载中（4 派各自状态） -->
  <view class="phase-loading" wx:if="{{loading}}">
    <view class="user-question">
      <text class="user-question__label">你问：</text>
      <text class="user-question__text">{{question || '综合备课建议'}}</text>
    </view>

    <view class="school-status" wx:for="{{schoolList}}" wx:key="key">
      <view class="school-status__row">
        <text class="school-status__icon">✦</text>
        <text class="school-status__name">{{item.name}}</text>
        <text class="school-status__state">· 思考中...</text>
      </view>
    </view>

    <view class="loading-area">
      <view class="loading-area__dots">
        <view class="loading-area__dot"></view>
        <view class="loading-area__dot"></view>
        <view class="loading-area__dot"></view>
      </view>
      <text class="loading-area__hint">{{loadingHint}}</text>
    </view>
  </view>

  <!-- 阶段三：结果展示 -->
  <view class="phase-result" wx:if="{{done}}">
    <!-- 用户问题回显 -->
    <view class="user-question">
      <text class="user-question__label">你问：</text>
      <text class="user-question__text">{{askedQuestion || '综合备课建议'}}</text>
    </view>

    <!-- 4 派折叠（默认收起） -->
    <view class="school-fold">
      <view
        class="school-fold__item {{item.expanded ? 'school-fold__item--open' : ''}}"
        wx:for="{{schoolList}}"
        wx:key="key"
      >
        <view class="school-fold__header" bindtap="onToggleSchool" data-key="{{item.key}}">
          <text class="school-fold__check" wx:if="{{item.text}}">✓</text>
          <text class="school-fold__fail" wx:else>×</text>
          <text class="school-fold__name">{{item.name}}</text>
          <text class="school-fold__arrow">{{item.expanded ? '▾' : '▸'}}</text>
        </view>
        <view class="school-fold__body" wx:if="{{item.expanded && item.text}}">
          <text class="school-fold__text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 综合建议（视觉重点） -->
    <view class="synthesis" wx:if="{{judgeText}}">
      <view class="synthesis__divider"></view>
      <text class="synthesis__title serif">综合建议</text>
      <view class="synthesis__divider"></view>
      <view class="synthesis__body">
        <text class="synthesis__text">{{judgeText}}</text>
      </view>
    </view>

    <!-- 免责声明 -->
    <view class="disclaimer">
      <text>ⓘ AI 生成，仅供参考；最终决定由教练做</text>
    </view>

    <!-- 操作按钮组 -->
    <view class="actions">
      <view class="actions__row">
        <view class="actions__primary" bindtap="onApplyToSession">应用到下次课程</view>
        <view class="actions__secondary" bindtap="onStartFollowup">继续追问 →</view>
      </view>
      <view class="actions__link" bindtap="onSaveToProfile">保存到客档</view>
    </view>
  </view>

  <!-- 追问模式 -->
  <view class="phase-followup" wx:if="{{showFollowup}}">
    <view class="followup__history" wx:if="{{followups.length}}">
      <view class="followup__item" wx:for="{{followups}}" wx:key="index">
        <text class="followup__q">你问：{{item.question}}</text>
        <text class="followup__a">{{item.answer}}</text>
      </view>
    </view>
    <view class="followup__input-row">
      <input
        class="followup__field"
        value="{{followupText}}"
        bindinput="onFollowupInput"
        placeholder="接着问"
        confirm-type="send"
        bindconfirm="onSendFollowup"
        disabled="{{followupLoading}}"
      />
      <view class="followup__send {{followupLoading ? 'followup__send--disabled' : ''}}" bindtap="onSendFollowup">
        <text>{{followupLoading ? '...' : '发送 →'}}</text>
      </view>
    </view>
  </view>
</view>
