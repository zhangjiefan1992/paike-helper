.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 200rpx;
}

/* === Loading === */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 32rpx;
  gap: 32rpx;
}
.loading__spinner {
  width: 56rpx;
  height: 56rpx;
  border: 2rpx solid var(--rule);
  border-top-color: var(--ink);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading__text {
  font-family: var(--display);
  font-style: italic;
  font-size: 26rpx;
  color: var(--ink-3);
}

/* === Info card === */
.info-card {
  margin: 44rpx 56rpx 28rpx;
  padding: 32rpx 0;
  border-top: 1rpx solid var(--rule);
  border-bottom: 1rpx solid var(--rule);
}
.info-card__row {
  display: flex;
  align-items: baseline;
  padding: 12rpx 0;
  gap: 32rpx;
}
.info-card__label {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  width: 100rpx;
  flex-shrink: 0;
}
.info-card__value {
  font-family: var(--display);
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: -0.005em;
  flex: 1;
}

/* === Photos === */
.photos-section {
  margin: 0 56rpx 36rpx;
}
.photos-group {
  margin-bottom: 32rpx;
}
.photos-group__title {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.photos-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--rule);
}
.photo-add {
  display: inline-flex;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: transparent;
  border: 1rpx dashed var(--rule);
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.photo-add__icon {
  font-size: 44rpx;
  color: var(--ink-4);
  font-weight: 300;
}

/* === Summary === */
.summary-section {
  margin: 36rpx 56rpx;
}
.summary-section__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.summary-section__title {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 500;
}
.summary-section__edit {
  font-size: 24rpx;
  color: var(--ink-2);
  letter-spacing: 0.06em;
  padding: 8rpx 12rpx;
}
.summary-section__edit:active { color: var(--color-primary); }

.summary-text {
  font-family: var(--display);
  font-size: 30rpx;
  line-height: 1.85;
  color: var(--ink-2);
  letter-spacing: 0.005em;
  padding: 16rpx 0;
}
.summary-edit {
  width: 100%;
  font-family: var(--display);
  font-size: 30rpx;
  line-height: 1.85;
  color: var(--ink);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--rule);
  box-sizing: border-box;
  min-height: 240rpx;
}

/* === Bottom bar === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 56rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: linear-gradient(to bottom, transparent, var(--paper) 30%);
}
.btn-primary {
  background: var(--ink);
  color: var(--paper);
  border-radius: 999rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  letter-spacing: 0.08em;
}
.btn-primary:active { background: var(--ink-2); }
