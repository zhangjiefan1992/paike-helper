.voice-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 24rpx 32rpx 16rpx;
  padding: 20rpx 0;
  background: var(--bg-card, #fff);
  border-radius: var(--radius-card, 16rpx);
  border: 2rpx dashed var(--color-primary, #4A7C59);
  box-shadow: var(--shadow-card, 0 2rpx 12rpx rgba(0,0,0,0.04));
}

.voice-entry__icon {
  font-size: 36rpx;
}

.voice-entry__text {
  font-size: 28rpx;
  color: var(--color-primary, #4A7C59);
  font-weight: 500;
}

/* Panel */
.voice-panel {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
}

.voice-panel__mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
}

.voice-panel__body {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: var(--bg-card, #fff);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  min-height: 560rpx;
  display: flex;
  flex-direction: column;
}

.voice-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.voice-panel__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary, #1a1a1a);
}

.voice-panel__close {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  color: var(--text-muted, #999);
}

/* Text area */
.voice-panel__text-area {
  flex: 1;
  min-height: 180rpx;
  max-height: 320rpx;
  overflow-y: auto;
  padding: 24rpx;
  background: var(--bg-page, #f5f5f5);
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.voice-panel__transcript {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary, #1a1a1a);
}

.voice-panel__placeholder {
  font-size: 26rpx;
  color: var(--text-muted, #999);
}

.voice-panel__listening {
  font-size: 26rpx;
  color: var(--color-primary, #4A7C59);
}

/* Record button */
.voice-panel__record-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.voice-panel__record-btn {
  position: relative;
  width: 128rpx; height: 128rpx;
  border-radius: 50%;
  background: var(--color-primary, #4A7C59);
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.15s, box-shadow 0.15s;
}

.voice-panel__record-btn--active {
  transform: scale(1.1);
  box-shadow: 0 0 0 12rpx rgba(74, 124, 89, 0.2);
}

.voice-panel__ripple {
  position: absolute;
  width: 100%; height: 100%;
  border-radius: 50%;
  border: 4rpx solid var(--color-primary, #4A7C59);
  animation: ripple 1.2s infinite;
}

@keyframes ripple {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(1.8); opacity: 0; }
}

.voice-panel__record-icon {
  font-size: 48rpx;
  color: #fff;
}

.voice-panel__hint {
  font-size: 24rpx;
  color: var(--text-muted, #999);
}

/* Loading */
.voice-panel__loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx 0;
}

.voice-panel__spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid var(--bg-hairline, #e5e5e5);
  border-top-color: var(--color-primary, #4A7C59);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.voice-panel__loading-text {
  font-size: 26rpx;
  color: var(--text-muted, #999);
}

/* Error */
.voice-panel__error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 0;
}

.voice-panel__error-text {
  font-size: 26rpx;
  color: #D03050;
  text-align: center;
}

.voice-panel__retry {
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  background: var(--color-primary, #4A7C59);
  color: #fff;
  font-size: 26rpx;
}
