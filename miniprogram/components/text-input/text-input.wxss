/* === Collapsed entry === */
.entry {
  margin: 32rpx 56rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: rgba(74, 124, 89, 0.05);
  border: 1rpx solid rgba(74, 124, 89, 0.18);
  border-radius: 16rpx;
}
.entry:active {
  background: rgba(74, 124, 89, 0.08);
}
.entry__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.entry__title {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: -0.005em;
}
.entry__hint {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.01em;
}
.entry__arrow {
  font-family: var(--display);
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: 300;
  flex-shrink: 0;
}

/* === Expanded panel === */
.panel {
  margin: 32rpx 56rpx;
  padding: 32rpx;
  background: var(--paper);
  border: 1rpx solid var(--rule);
  border-radius: 20rpx;
}
.panel__header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}
.panel__title {
  font-size: 36rpx;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.panel__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink-3);
  line-height: 1;
}

.panel__textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 0;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink);
  border-bottom: 1rpx solid var(--rule);
  letter-spacing: 0.01em;
  box-sizing: border-box;
}
.panel__placeholder {
  color: var(--ink-4);
  font-style: italic;
  letter-spacing: 0.01em;
}

.panel__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 16rpx;
}
.panel__tip {
  flex: 1;
  font-style: italic;
  font-weight: 300;
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: 0.01em;
}
.panel__submit {
  padding: 16rpx 32rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: 26rpx;
  letter-spacing: 0.06em;
  border-radius: 999rpx;
}
.panel__submit:active { background: var(--ink-2); }
.panel__submit--disabled {
  background: var(--ink-5);
  color: var(--paper);
  opacity: 0.6;
}

.panel__error {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(181, 87, 61, 0.08);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.panel__error-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--warm);
  line-height: 1.5;
}
.panel__error-close {
  font-size: 22rpx;
  color: var(--warm);
  letter-spacing: 0.04em;
  padding: 8rpx 12rpx;
}
