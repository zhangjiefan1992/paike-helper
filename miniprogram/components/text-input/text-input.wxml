<view class="entry" bindtap="onExpand" wx:if="{{!expanded}}">
  <view class="entry__main">
    <text class="entry__title serif">一句话排课</text>
    <text class="entry__hint">如「明天下午3点给张三上普拉提，旺君馆」</text>
  </view>
  <text class="entry__arrow">→</text>
</view>

<view class="panel" wx:if="{{expanded}}">
  <view class="panel__header">
    <text class="panel__title serif">一句话排课</text>
    <view class="panel__close" bindtap="onClose">×</view>
  </view>

  <textarea
    class="panel__textarea"
    value="{{inputText}}"
    bindinput="onInput"
    placeholder="例：明天下午三点给张三上普拉提，旺君馆"
    placeholder-class="panel__placeholder"
    auto-height
    maxlength="200"
    focus="{{expanded}}"
    bindconfirm="onSubmit"
  />

  <view class="panel__actions">
    <text class="panel__tip serif">AI 自动识别时间、会员、课程</text>
    <view
      class="panel__submit {{!inputText || loading ? 'panel__submit--disabled' : ''}}"
      bindtap="onSubmit"
    >
      <text wx:if="{{loading}}">解析中</text>
      <text wx:else>解析 →</text>
    </view>
  </view>

  <view class="panel__error" wx:if="{{errorMsg}}">
    <text class="panel__error-text">{{errorMsg}}</text>
    <view class="panel__error-close" bindtap="onClearError">关闭</view>
  </view>
</view>
