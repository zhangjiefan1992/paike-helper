.card-wrapper {
  position: relative;
  margin-bottom: 12rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.movable-area {
  width: 100%;
  height: 140rpx;
}

.movable-view {
  width: 100%;
  height: 100%;
  z-index: 2;
}

.card {
  display: flex;
  align-items: stretch;
  background: var(--paper);
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  height: 100%;
  overflow: hidden;
}

.card--compact {
  height: auto;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background: rgba(74, 124, 89, 0.04);
  border-color: rgba(74, 124, 89, 0.12);
}

.card__border {
  width: 4rpx;
  flex-shrink: 0;
  align-self: stretch;
  border-radius: 2rpx;
  margin: 12rpx 0;
  margin-left: 12rpx;
}
.card--compact .card__border {
  width: 3rpx;
  margin: 8rpx 0 8rpx 8rpx;
}

.card--scheduled .card__border { background: var(--ink-3); }
.card--completed .card__border { background: var(--color-primary); }
.card--cancelled .card__border { background: var(--ink-5); }
.card--noshow .card__border { background: var(--warm); }

.card--completed { opacity: 0.55; }
.card--cancelled .card__name,
.card--cancelled .card__type {
  text-decoration: line-through;
  color: var(--ink-4);
}

.card__content {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 20rpx;
  min-width: 0;
}

.card--compact .card__content {
  padding: 10rpx 14rpx;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
}

.card__time {
  font-family: var(--display);
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 400;
  flex-shrink: 0;
  width: 96rpx;
  letter-spacing: 0.01em;
}
.card--compact .card__time {
  font-size: 20rpx;
  width: auto;
  color: var(--ink-3);
}

.card__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card__name {
  font-family: var(--display);
  font-size: 30rpx;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: -0.005em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card--compact .card__name {
  font-size: 22rpx;
  font-weight: 400;
}

.card__type {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 0.01em;
}

.card__location-compact {
  font-size: 19rpx;
  color: var(--ink-4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card__detail {
  display: flex;
  align-items: center;
}

.card__location {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.02em;
}

.card__duration {
  font-family: var(--display);
  font-size: 22rpx;
  color: var(--ink-4);
  flex-shrink: 0;
  letter-spacing: 0.02em;
}

.card__check {
  font-size: 28rpx;
  color: var(--color-primary);
  margin-left: auto;
}

/* Post-class summary dot */
.card__dot {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.card__dot--pending {
  background: var(--warm);
  animation: dot-pulse 2s ease-in-out infinite;
}
.card__dot--done {
  background: var(--color-primary);
}
@keyframes dot-pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

.card__actions {
  position: absolute;
  right: 0;
  top: 0;
  height: 100%;
  display: flex;
  z-index: 1;
}

.action {
  width: 160rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--paper);
  font-size: 24rpx;
  letter-spacing: 0.06em;
}

.action--complete { background: var(--color-primary); }
.action--cancel { background: var(--ink-3); }
